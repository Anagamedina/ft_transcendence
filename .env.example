# `make env` copies this file to .env the first time (it never overwrites an
# existing .env) and gives the four secret keys a random value: SECRET_KEY,
# INGEST_API_KEY, PUBLIC_API_KEY and PUBLIC_API_WRITE_KEY.
# The values that start with "dev-only" are only for local development. Anyone
# can read them here, so with ENV=production the backend will not start if one
# of them is still in use.

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
POSTGRES_USER=user01
POSTGRES_PASSWORD=passw01
POSTGRES_DB=postgresdb
# Host and port for running the backend outside Docker. Inside Docker Compose
# the backend always connects to the `database` service instead.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# Backend
# ----------------------------------------------------------------------------
# Environment: development, test or production.
ENV=development
# Secret used to sign the login session cookie.
SECRET_KEY=dev-only-change-me
# Send the session cookie over HTTPS only. Keep it true: the gateway always
# serves the app over HTTPS.
COOKIE_SECURE=true
# Web addresses that may call the API from a browser (for example the Vite
# dev server).
CORS_ORIGINS=https://localhost:5173,http://localhost:5173,http://localhost:3000,http://localhost:42424
# Password the simulator sends with every reading, in the X-Ingest-Key header.
# Without it, anyone could send fake readings and open fake alerts.
INGEST_API_KEY=dev-only-ingest-key

# ----------------------------------------------------------------------------
# Public API (/api/public/v1)
# ----------------------------------------------------------------------------
# External tools call this API with one of these two keys in the X-API-Key
# header. Use different values from INGEST_API_KEY.
#
# Read-only key: it can only call the GET endpoints.
PUBLIC_API_KEY=dev-only-public-api-key
# Read and write key: it can also create, replace and delete buildings.
# Leave it empty if nobody should be able to change data through the API.
PUBLIC_API_WRITE_KEY=dev-only-public-api-write-key
# The organization the API works with. Both keys only see and change the data
# of this organization. The value below is Residencias Collserola from the
# demo data, so the API works right after `make demo`. In production, set the
# id of a real organization: the backend will not start with the demo one.
PUBLIC_API_ORGANIZATION_ID=00000000-0000-4000-9000-000000000001

# ----------------------------------------------------------------------------
# Invitations and free trial
# ----------------------------------------------------------------------------
# Start of the links sent by email, such as invitation links.
PUBLIC_BASE_URL=https://localhost
# Number of days an invitation link stays valid.
INVITATION_TTL_DAYS=1
# Number of days of free trial for a new organization.
TRIAL_DAYS=7

# ----------------------------------------------------------------------------
# Uploaded documents
# ----------------------------------------------------------------------------
# Folder inside the backend container where uploaded files are saved.
DOCUMENTS_DIR=/data/documents
# Largest file size allowed, in megabytes.
MAX_UPLOAD_MB=10

# ----------------------------------------------------------------------------
# Request limits (applied by the Nginx gateway, per IP address)
# ----------------------------------------------------------------------------
# Format: 10r/m means 10 requests per minute, 10r/s means 10 per second.
#
# Limit for login, sign-up and invitations. Each of the three has its own
# counter.
PUBLIC_RATE_LIMIT=10r/m
# Limit for the public API. It has its own counter too.
PUBLIC_API_RATE_LIMIT=60r/m

# ----------------------------------------------------------------------------
# Backups
# ----------------------------------------------------------------------------
# Hours between two automatic backups.
BACKUP_INTERVAL_HOURS=24
# Number of backups to keep. Older ones are deleted.
BACKUP_KEEP=7

# ----------------------------------------------------------------------------
# Emails (alerts, data download and account deletion requests)
# ----------------------------------------------------------------------------
# In development, emails go to Mailpit, a fake mail server. You can read them
# at http://localhost:8025. Nothing is sent to real inboxes.
# To turn emails off, leave SMTP_HOST empty: they are only written to the
# backend log.
# To use a real mail server, set its host, SMTP_PORT=587, SMTP_STARTTLS=true,
# and the user and password.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
# Put the password in quotes if it contains symbols
SMTP_PASSWORD=
# Sender address. Write only the address, with no name and no < >
SMTP_FROM=no-reply@aquaguard.dev
SMTP_STARTTLS=false

# ----------------------------------------------------------------------------
# Sensor simulator (started by `make sim` and `make demo`)
# ----------------------------------------------------------------------------
# Where the simulator sends its readings.
SIMULATOR_API_URL=http://backend:8000
# Random seed. The same number gives the same readings on every run.
SIMULATOR_SEED=42
# Ids of the 65 demo sensors. `make all` checks that this list is the same in
# your .env, so the demo data and the simulator always match.
SIMULATOR_SENSOR_IDS=00000000-0000-4000-8000-000000000001,00000000-0000-4000-8000-000000000002,00000000-0000-4000-8000-000000000003,00000000-0000-4000-8000-000000000004,00000000-0000-4000-8000-000000000005,00000000-0000-4000-8000-000000000006,00000000-0000-4000-8000-000000000007,00000000-0000-4000-8000-000000000008,00000000-0000-4000-8000-000000000009,00000000-0000-4000-8000-000000000010,00000000-0000-4000-8000-000000000011,00000000-0000-4000-8000-000000000012,00000000-0000-4000-8000-000000000013,00000000-0000-4000-8000-000000000014,00000000-0000-4000-8000-000000000015,00000000-0000-4000-8000-000000000016,00000000-0000-4000-8000-000000000017,00000000-0000-4000-8000-000000000018,00000000-0000-4000-8000-000000000019,00000000-0000-4000-8000-000000000020,00000000-0000-4000-8000-000000000021,00000000-0000-4000-8000-000000000022,00000000-0000-4000-8000-000000000023,00000000-0000-4000-8000-000000000024,00000000-0000-4000-8000-000000000025,00000000-0000-4000-8000-000000000026,00000000-0000-4000-8000-000000000027,00000000-0000-4000-8000-000000000028,00000000-0000-4000-8000-000000000029,00000000-0000-4000-8000-000000000030,00000000-0000-4000-8000-000000000031,00000000-0000-4000-8000-000000000032,00000000-0000-4000-8000-000000000033,00000000-0000-4000-8000-000000000034,00000000-0000-4000-8000-000000000035,00000000-0000-4000-8000-000000000036,00000000-0000-4000-8000-000000000037,00000000-0000-4000-8000-000000000038,00000000-0000-4000-8000-000000000039,00000000-0000-4000-8000-000000000040,00000000-0000-4000-8000-000000000041,00000000-0000-4000-8000-000000000042,00000000-0000-4000-8000-000000000043,00000000-0000-4000-8000-000000000044,00000000-0000-4000-8000-000000000045,00000000-0000-4000-8000-000000000046,00000000-0000-4000-8000-000000000047,00000000-0000-4000-8000-000000000048,00000000-0000-4000-8000-000000000049,00000000-0000-4000-8000-000000000050,00000000-0000-4000-8000-000000000051,00000000-0000-4000-8000-000000000052,00000000-0000-4000-8000-000000000053,00000000-0000-4000-8000-000000000054,00000000-0000-4000-8000-000000000055,00000000-0000-4000-8000-000000000056,00000000-0000-4000-8000-000000000057,00000000-0000-4000-8000-000000000058,00000000-0000-4000-8000-000000000059,00000000-0000-4000-8000-000000000060,00000000-0000-4000-8000-000000000061,00000000-0000-4000-8000-000000000062,00000000-0000-4000-8000-000000000063,00000000-0000-4000-8000-000000000064,00000000-0000-4000-8000-000000000065
# Default behaviour of every sensor: normal, low, high or offline.
SIMULATOR_SCENARIO=normal
# Sensors that behave differently, as <sensor_id>:<behaviour>. In the demo,
# sensor 4 keeps a low pressure (so its alert stays open) and sensor 7 sends
# nothing (so it shows as offline).
SIMULATOR_SCENARIOS=00000000-0000-4000-8000-000000000004:low,00000000-0000-4000-8000-000000000007:offline
# Seconds between two rounds of readings.
SIMULATOR_INTERVAL_SECONDS=5
# Seconds to wait for the backend to answer one reading.
SIMULATOR_REQUEST_TIMEOUT_SECONDS=5
# How many times to retry a reading that failed.
SIMULATOR_MAX_RETRIES=3
# true: create the readings and log them, but do not send them.
SIMULATOR_DRY_RUN=false
# At start-up the simulator waits until the backend is ready. It checks every
# SIMULATOR_READY_POLL_SECONDS and gives up after
# SIMULATOR_READY_TIMEOUT_SECONDS (0 means wait forever).
SIMULATOR_READY_POLL_SECONDS=2
SIMULATOR_READY_TIMEOUT_SECONDS=60
# File the simulator updates after every round. The Docker health check reads
# it to know the simulator is still working.
SIMULATOR_HEARTBEAT_FILE=/tmp/simulator-heartbeat
