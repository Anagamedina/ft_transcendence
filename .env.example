POSTGRES_USER=user01
POSTGRES_PASSWORD=passw01

POSTGRES_DB=postgresdb

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

ENV=development
SECRET_KEY=dev-only-change-me
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Clave que el simulador manda en X-Ingest-Key con cada lectura (issue #106).
# Este valor solo vale para desarrollo: con ENV=production el backend no arranca si no se cambia.
INGEST_API_KEY=dev-only-ingest-key

SIMULATOR_API_URL=http://backend:8000
SIMULATOR_SEED=42
SIMULATOR_SENSOR_IDS=00000000-0000-4000-8000-000000000001,00000000-0000-4000-8000-000000000002,00000000-0000-4000-8000-000000000003,00000000-0000-4000-8000-000000000004,00000000-0000-4000-8000-000000000005,00000000-0000-4000-8000-000000000006,00000000-0000-4000-8000-000000000008
SIMULATOR_SCENARIO=normal
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_REQUEST_TIMEOUT_SECONDS=5
SIMULATOR_MAX_RETRIES=3
SIMULATOR_DRY_RUN=false
SIMULATOR_READY_POLL_SECONDS=2
SIMULATOR_READY_TIMEOUT_SECONDS=60
SIMULATOR_HEARTBEAT_FILE=/tmp/simulator-heartbeat
