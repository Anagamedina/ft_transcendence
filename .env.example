POSTGRES_USER=user01
POSTGRES_PASSWORD=passw01

POSTGRES_DB=postgresdb

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

ENV=development
# make env sustituye SECRET_KEY e INGEST_API_KEY por claves aleatorias al crear el .env.
SECRET_KEY=dev-only-change-me
# El gateway siempre sirve HTTPS, así que la cookie de sesión va con Secure.
COOKIE_SECURE=true
CORS_ORIGINS=https://localhost:5173,http://localhost:5173,http://localhost:3000
# Clave que el simulador manda en X-Ingest-Key con cada lectura (issue #106).
# Este valor solo vale para desarrollo: con ENV=production el backend no arranca si no se cambia.
INGEST_API_KEY=dev-only-ingest-key

# Base de los enlaces que se envían por correo (invitaciones).
PUBLIC_BASE_URL=https://localhost
# Días que tarda en caducar una invitación.
INVITATION_TTL_DAYS=7
# Días de prueba al registrarse.
TRIAL_DAYS=7
# Carpeta del backend donde se guardan los documentos y tamaño máximo por archivo.
DOCUMENTS_DIR=/data/documents
MAX_UPLOAD_MB=10
# Límite por IP en login, registro e invitaciones, cada uno con su propio contador
# (formato de Nginx: 10r/m, 10r/s).
PUBLIC_RATE_LIMIT=10r/m
# Backups automáticos: cada cuántas horas se lanza uno y cuántos se conservan.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# Emails de confirmación (descargar mis datos y pedir la baja).
# Por defecto van a Mailpit, que los captura y los enseña en http://localhost:8025.
# Vacío (SMTP_HOST=) desactiva el envío: solo se anota en el log del backend.
# Para un servidor real: su host, SMTP_PORT=587, SMTP_STARTTLS=true, usuario y contraseña.
# SMTP_FROM es solo la dirección, sin nombre ni < >; la contraseña, entre comillas si lleva símbolos.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@aquaguard.dev
SMTP_STARTTLS=false

SIMULATOR_API_URL=http://backend:8000
SIMULATOR_SEED=42
SIMULATOR_SENSOR_IDS=00000000-0000-4000-8000-000000000001,00000000-0000-4000-8000-000000000002,00000000-0000-4000-8000-000000000003,00000000-0000-4000-8000-000000000004,00000000-0000-4000-8000-000000000005,00000000-0000-4000-8000-000000000006,00000000-0000-4000-8000-000000000007,00000000-0000-4000-8000-000000000008
SIMULATOR_SCENARIO=normal
# Per-sensor scenario (<sensor_id>:<normal|low|high|offline>); the rest use SIMULATOR_SCENARIO.
# Demo: SENS-004 keeps low pressure (its seeded alert stays real) and SENS-007 is offline.
SIMULATOR_SCENARIOS=00000000-0000-4000-8000-000000000004:low,00000000-0000-4000-8000-000000000007:offline
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_REQUEST_TIMEOUT_SECONDS=5
SIMULATOR_MAX_RETRIES=3
SIMULATOR_DRY_RUN=false
SIMULATOR_READY_POLL_SECONDS=2
SIMULATOR_READY_TIMEOUT_SECONDS=60
SIMULATOR_HEARTBEAT_FILE=/tmp/simulator-heartbeat
