al | None" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c65"><mxGeometry y="84" width="310" height="20" as="geometry"/></mxCell><mxCell id="c69" value="○ last_seen_at  (no existe, #97)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c65"><mxGeometry y="104" width="310" height="20" as="geometry"/></mxCell><mxCell id="c70" style="line;html=1;strokeWidth=1;" vertex="1" parent="c65"><mxGeometry y="124" width="310" height="8" as="geometry"/></mxCell><mxCell id="c71" value="Depends" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c3" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c72" value="alerts" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;endArrow=open;endFill=0;" edge="1" parent="1" source="c14" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c73" value="alerts" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;endArrow=open;endFill=0;" edge="1" parent="1" source="c22" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c74" value="evaluar_presion()" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c22" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c75" value="devuelve" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c29" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c76" value="cumple" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;dashed=1;endArrow=block;endFill=0;endSize=12;" edge="1" parent="1" source="c45" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c77" value="lee / escribe" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c45" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c78" value="1 ── 0..*" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="c65" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c79" value="usa" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c80" value="&lt;b&gt;Decisiones de negocio (Ana, 28-09-2026)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Una sola ACTIVE por sensor y tipo&lt;/b&gt;: cien lecturas bajas son la misma alerta, no cien.&lt;br&gt;• &lt;b&gt;La severidad solo sube&lt;/b&gt;: WARNING → CRITICAL, nunca al revés.&lt;br&gt;• &lt;b&gt;No se resuelve sola&lt;/b&gt;: aunque la presión vuelva al rango, sigue ACTIVE hasta el PATCH /resolve.&lt;br&gt;• CRITICAL = fuera del umbral &lt;b&gt;más de un 20 %&lt;/b&gt; (provisional, se cambia en MARGEN_CRITICO)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1000" y="720" width="400" height="200" as="geometry"/></mxCell><mxCell id="c81" value="&lt;b&gt;¿Por qué rules.py es una función pura?&lt;/b&gt;&lt;br&gt;Solo decide: recibe valor y umbrales y contesta. No mira la base ni guarda nada. Así cada caso se prueba sin PostgreSQL, y se reutiliza el día que lleguen lecturas por WebSocket.&lt;br&gt;&lt;br&gt;Usa &lt;b&gt;Decimal&lt;/b&gt;: en float, 1.5 × 0.8 = 1.2000000000000002." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1490" y="552" width="310" height="200" as="geometry"/></mxCell><mxCell id="c82" value="&lt;b&gt;○ Pendiente en la #28&lt;/b&gt;&lt;br&gt;• Regla SENSOR_OFFLINE: necesita &lt;i&gt;last_seen_at&lt;/i&gt;, que no existe en la tabla (#97, Daruny).&lt;br&gt;• Mergear la PR #98." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="380" height="110" as="geometry"/></mxCell><mxCell id="c83" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="300" height="20" as="geometry"/></mxCell><mxCell id="c84" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="918" width="30" height="18" as="geometry"/></mxCell><mxCell id="c85" value="escrito o cambiado en esta issue (★ = nuevo)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="916" width="330" height="22" as="geometry"/></mxCell><mxCell id="c86" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="944" width="30" height="18" as="geometry"/></mxCell><mxCell id="c87" value="ya existía" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="942" width="330" height="22" as="geometry"/></mxCell><mxCell id="c88" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="30" height="18" as="geometry"/></mxCell><mxCell id="c89" value="contrato (Protocol)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="968" width="330" height="22" as="geometry"/></mxCell><mxCell id="c90" value="" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="996" width="30" height="18" as="geometry"/></mxCell><mxCell id="c91" value="modelo / tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="994" width="330" height="22" as="geometry"/></mxCell><mxCell id="c92" value="" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="1022" width="30" height="18" as="geometry"/></mxCell><mxCell id="c93" value="error de dominio" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1020" width="330" height="22" as="geometry"/></mxCell><mxCell id="c94" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="1048" width="30" height="18" as="geometry"/></mxCell><mxCell id="c95" value="en la PR #98, aún sin mergear" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1046" width="330" height="22" as="geometry"/></mxCell><mxCell id="c96" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1074" width="30" height="18" as="geometry"/></mxCell><mxCell id="c97" value="pendiente" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1072" width="330" height="22" as="geometry"/></mxCell><mxCell id="c98" value="&lt;font style='font-size:11px'&gt;- - -▷ &amp;nbsp;cumple el contrato (realización)&lt;br&gt;- - -&amp;gt; &amp;nbsp;depende de / usa&lt;br&gt;——&amp;gt; &amp;nbsp;tiene una referencia (asociación)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1104" width="380" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2___Secuencia" name="2 · Secuencia"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="1702" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L0" value="Simulador / Operador" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="150" height="1552" as="geometry"/></mxCell><mxCell id="L1" value="readings router" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="260" y="110" width="150" height="1552" as="geometry"/></mxCell><mxCell id="L2" value="ReadingService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="150" height="1552" as="geometry"/></mxCell><mxCell id="L3" value="rules.py" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="660" y="110" width="150" height="1552" as="geometry"/></mxCell><mxCell id="L4" value="alerts router" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="110" width="150" height="1552" as="geometry"/></mxCell><mxCell id="L5" value="AlertService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1060" y="110" width="150" height="1552" as="geometry"/></mxCell><mxCell id="L6" value="AlertRepository" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="150" height="1552" as="geometry"/></mxCell><mxCell id="L7" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1460" y="110" width="150" height="1552" as="geometry"/></mxCell><mxCell id="c2" value="&lt;font style='font-size:20px'&gt;&lt;b&gt;Issue #28 · de la lectura a la alerta resuelta — diagrama de secuencia&lt;/b&gt;&lt;/font&gt;&lt;br&gt;A: el simulador envía una presión baja y se abre una alerta (PR #98). B: un operador la ve, la reconoce y la cierra (PR #78)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="-80" height="70" as="geometry"/></mxCell><mxCell id="c3" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="214" as="sourcePoint"/><mxPoint x="1630.0" y="214" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" value="&lt;b&gt;A · Entra una lectura fuera de umbral  (PR #98)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1a4d8f;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="900" height="22" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;1. POST /api/readings { sensor_id, pressure: 1.1 }&lt;/b&gt;" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="266" as="sourcePoint"/><mxPoint x="335.0" y="266" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="2. create(payload)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335.0" y="298" as="sourcePoint"/><mxPoint x="535.0" y="298" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="3. SELECT sensor + INSERT reading  (lo de la #24)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="535.0" y="360" as="sourcePoint"/><mxPoint x="1535.0" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;4. _aplicar_reglas(sensor, 1.1)&lt;/b&gt;" style="html=1;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="535.0" y="380" as="sourcePoint"/><mxPoint x="535.0" y="404" as="targetPoint"/><Array as="points"><mxPoint x="569.0" y="380"/><mxPoint x="569.0" y="404"/></Array></mxGeometry></mxCell><mxCell id="c9" value="5. evaluar_presion(1.1, low=1.5, high=10, &amp;quot;bar&amp;quot;)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="535.0" y="430" as="sourcePoint"/><mxPoint x="735.0" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="AlertaPropuesta(LOW_PRESSURE, CRITICAL, «Presión por debajo…»)&lt;br&gt;1.1 &amp;lt; 1.5 × 0.8 = 1.2 → CRITICAL" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="735.0" y="476" as="sourcePoint"/><mxPoint x="535.0" y="476" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="return, no se toca nada" style="html=1;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="535.0" y="526" as="sourcePoint"/><mxPoint x="535.0" y="550" as="targetPoint"/><Array as="points"><mxPoint x="569.0" y="526"/><mxPoint x="569.0" y="550"/></Array></mxGeometry></mxCell><mxCell id="c12" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=46;height=20;fontSize=11;fontStyle=1;fillColor=none;strokeColor=#6c8ebf;fillColor=none;" vertex="1" parent="1"><mxGeometry x="455.0" y="492" width="360.0" height="72" as="geometry"/></mxCell><mxCell id="c13" value="&lt;i&gt;[la propuesta es None: presión normal]&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="507.0" y="493" width="300.0" height="20" as="geometry"/></mxCell><mxCell id="c14" value="6. get_active(sensor_id, &amp;quot;LOW_PRESSURE&amp;quot;)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="535.0" y="596" as="sourcePoint"/><mxPoint x="1335.0" y="596" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="SELECT … WHERE status = 'ACTIVE' ORDER BY created_at DESC LIMIT 1" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335.0" y="628" as="sourcePoint"/><mxPoint x="1535.0" y="628" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="Alert | None" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335.0" y="660" as="sourcePoint"/><mxPoint x="535.0" y="660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="7a. create(sensor_id, alert_type, severity, message)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="535.0" y="722" as="sourcePoint"/><mxPoint x="1335.0" y="722" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="INSERT alert  (status ACTIVE)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335.0" y="754" as="sourcePoint"/><mxPoint x="1535.0" y="754" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=46;height=20;fontSize=11;fontStyle=1;fillColor=none;fillColor=#f8cecc;strokeColor=#b85450;fillColor=none;" vertex="1" parent="1"><mxGeometry x="455.0" y="676" width="1160.0" height="98" as="geometry"/></mxCell><mxCell id="c20" value="&lt;i&gt;[no hay ninguna ACTIVE de ese tipo]&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="507.0" y="677" width="1100.0" height="20" as="geometry"/></mxCell><mxCell id="c21" value="7b. escalate(alert, CRITICAL, mensaje nuevo)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="535.0" y="836" as="sourcePoint"/><mxPoint x="1335.0" y="836" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="UPDATE alert SET severity, message" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335.0" y="868" as="sourcePoint"/><mxPoint x="1535.0" y="868" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=46;height=20;fontSize=11;fontStyle=1;fillColor=none;fillColor=#f8cecc;strokeColor=#b85450;fillColor=none;" vertex="1" parent="1"><mxGeometry x="455.0" y="790" width="1160.0" height="98" as="geometry"/></mxCell><mxCell id="c24" value="&lt;i&gt;[hay una ACTIVE en WARNING y la propuesta es CRITICAL]&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="507.0" y="791" width="1100.0" height="20" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;8. COMMIT: la lectura y su alerta, juntas o ninguna&lt;/b&gt;" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="535.0" y="920" as="sourcePoint"/><mxPoint x="1535.0" y="920" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="tx" style="shape=umlFrame;whiteSpace=wrap;html=1;width=46;height=20;fontSize=11;fontStyle=1;fillColor=none;strokeColor=#6c8ebf;fillColor=none;" vertex="1" parent="1"><mxGeometry x="455.0" y="314" width="1160.0" height="626" as="geometry"/></mxCell><mxCell id="c27" value="&lt;i&gt;[with transaction(db): todo o nada]&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="507.0" y="315" width="1100.0" height="20" as="geometry"/></mxCell><mxCell id="c28" value="ReadingResponse" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="535.0" y="972" as="sourcePoint"/><mxPoint x="335.0" y="972" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;201 Created&lt;/b&gt;" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335.0" y="1004" as="sourcePoint"/><mxPoint x="135.0" y="1004" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="1034" as="sourcePoint"/><mxPoint x="1630.0" y="1034" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;B · Un operador la gestiona desde el dashboard  (PR #78, con sesión)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1a4d8f;" vertex="1" parent="1"><mxGeometry x="40" y="1036" width="900" height="22" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;9. GET /api/alerts?status=ACTIVE&lt;/b&gt;" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="1086" as="sourcePoint"/><mxPoint x="935.0" y="1086" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="list(organization_id = user.organization_id, …)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935.0" y="1118" as="sourcePoint"/><mxPoint x="1135.0" y="1118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="list_by_organization(organization_id, status, sensor_id, offset, limit)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="1150" as="sourcePoint"/><mxPoint x="1335.0" y="1150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="SELECT alert JOIN sensor JOIN site WHERE organization_id = :org" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335.0" y="1182" as="sourcePoint"/><mxPoint x="1535.0" y="1182" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="200 Page[AlertResponse]" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935.0" y="1214" as="sourcePoint"/><mxPoint x="135.0" y="1214" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;10. PATCH /api/alerts/{id}/acknowledge&lt;/b&gt;" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="1246" as="sourcePoint"/><mxPoint x="935.0" y="1246" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="acknowledge(id, organization_id)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935.0" y="1278" as="sourcePoint"/><mxPoint x="1135.0" y="1278" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="get_by_id(id, org)  → 404 ALERT_NOT_FOUND si no es suya" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="1310" as="sourcePoint"/><mxPoint x="1335.0" y="1310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="acknowledge(id, now)  → solo escribe si acknowledged_at está vacío" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="1342" as="sourcePoint"/><mxPoint x="1335.0" y="1342" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="200 AlertResponse  (sigue ACTIVE, ya consta que alguien la vio)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935.0" y="1374" as="sourcePoint"/><mxPoint x="135.0" y="1374" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;11. PATCH /api/alerts/{id}/resolve&lt;/b&gt;" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="1406" as="sourcePoint"/><mxPoint x="935.0" y="1406" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="resolve(id, organization_id)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935.0" y="1438" as="sourcePoint"/><mxPoint x="1135.0" y="1438" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="get_by_id(id, org)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="1470" as="sourcePoint"/><mxPoint x="1335.0" y="1470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="409 ALERT_ALREADY_RESOLVED  (no pisa resolved_at)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="1532" as="sourcePoint"/><mxPoint x="135.0" y="1532" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=46;height=20;fontSize=11;fontStyle=1;fillColor=none;fillColor=#f8cecc;strokeColor=#b85450;fillColor=none;" vertex="1" parent="1"><mxGeometry x="55.0" y="1486" width="1160.0" height="66" as="geometry"/></mxCell><mxCell id="c47" value="&lt;i&gt;[ya estaba RESOLVED]&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="107.0" y="1487" width="1100.0" height="20" as="geometry"/></mxCell><mxCell id="c48" value="resolve(id, now)  → status RESOLVED, resolved_at = now" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="1584" as="sourcePoint"/><mxPoint x="1335.0" y="1584" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="&lt;b&gt;200 AlertResponse  (RESOLVED)&lt;/b&gt;" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935.0" y="1616" as="sourcePoint"/><mxPoint x="135.0" y="1616" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="&lt;b&gt;¿Por qué dentro de la misma transacción?&lt;/b&gt;&lt;br&gt;Si guardar la alerta fallara, se deshace también la lectura. No puede quedar una presión de 1.1 bar guardada sin su alerta, ni una alerta sin la lectura que la abrió." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1660.0" y="200" width="340" height="150" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;¿Por qué resolver dos veces es un 409?&lt;/b&gt;&lt;br&gt;Volvería a escribir resolved_at y se perdería cuándo se atendió de verdad, que es el dato con el que se mide el tiempo de respuesta." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1660.0" y="380" width="340" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3___Estados_de_una_alerta" name="3 · Estados de una alerta"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style='font-size:20px'&gt;&lt;b&gt;Issue #28 · estados de una alerta — diagrama de estados&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Una alerta por &lt;b&gt;sensor y tipo&lt;/b&gt;: LOW_PRESSURE y HIGH_PRESSURE de un mismo sensor van cada una por su lado." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="70" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="80" y="335" width="30" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Sin alerta&lt;/b&gt;&lt;br&gt;(no hay ninguna ACTIVE&lt;br&gt;de ese sensor y tipo)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="170" y="310" width="190" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;ACTIVE · WARNING&lt;/b&gt;&lt;br&gt;acknowledged_at: vacío o con fecha" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="520" y="170" width="260" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;ACTIVE · CRITICAL&lt;/b&gt;&lt;br&gt;acknowledged_at: vacío o con fecha" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="520" y="450" width="260" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;RESOLVED&lt;/b&gt;&lt;br&gt;resolved_at = fecha del PATCH" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1000" y="310" width="220" height="80" as="geometry"/></mxCell><mxCell id="c8" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="lectura fuera de umbral&lt;br&gt;(≤ 20 %) · create()" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="265" y="215"/></Array></mxGeometry></mxCell><mxCell id="c10" value="lectura fuera de umbral&lt;br&gt;(&amp;gt; 20 %) · create()" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="265" y="495"/></Array></mxGeometry></mxCell><mxCell id="c11" value="llega una lectura CRITICAL&lt;br&gt;· escalate()" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="PATCH /resolve" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="215"/></Array></mxGeometry></mxCell><mxCell id="c13" value="PATCH /resolve" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="495"/></Array></mxGeometry></mxCell><mxCell id="c14" value="la próxima lectura fuera de umbral abre una alerta &lt;b&gt;nueva&lt;/b&gt;" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c7" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1066" y="660"/><mxPoint x="208" y="660"/></Array></mxGeometry></mxCell><mxCell id="c15" value="más lecturas WARNING, o PATCH /acknowledge:&lt;br&gt;la misma alerta, no otra" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1" source="c5" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="130"/><mxPoint x="700" y="130"/></Array></mxGeometry></mxCell><mxCell id="c16" value="más lecturas fuera, de cualquier severidad,&lt;br&gt;o PATCH /acknowledge: no baja a WARNING" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;exitX=0.3;exitY=1;entryX=0.7;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="598" y="580"/><mxPoint x="702" y="580"/></Array></mxGeometry></mxCell><mxCell id="c17" value="PATCH /resolve otra vez&lt;br&gt;→ 409 ALERT_ALREADY_RESOLVED" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;exitX=1;exitY=0.3;entryX=1;entryY=0.7;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="334"/><mxPoint x="1270" y="366"/></Array></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;Reconocer no es un estado&lt;/b&gt;&lt;br&gt;PATCH /acknowledge solo rellena &lt;i&gt;acknowledged_at&lt;/i&gt; la primera vez y la alerta sigue ACTIVE. Sirve para que el equipo sepa que alguien la está mirando." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1240" y="120" width="330" height="170" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;No se resuelve sola&lt;/b&gt;&lt;br&gt;Aunque la presión vuelva al rango, la alerta sigue ACTIVE hasta que una persona la cierra. Así nadie se pierde una bajada que duró cinco minutos." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1240" y="440" width="330" height="170" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;○ Falta SENSOR_OFFLINE&lt;/b&gt;&lt;br&gt;Se abriría cuando un sensor deje de enviar lecturas durante un tiempo. Necesita &lt;i&gt;last_seen_at&lt;/i&gt; en la tabla sensors, que aún no existe (#97, Daruny)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="560" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4___Flujo_global" name="4 · Flujo global"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style='font-size:22px'&gt;&lt;b&gt;AquaGuard · dónde encaja la #28&lt;/b&gt;&lt;/font&gt;&lt;br&gt;El recorrido de una lectura, desde el simulador hasta el dashboard. Lo que toca la #28 va con &lt;b&gt;borde negro grueso&lt;/b&gt;." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1770" height="70" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;1 · De dónde sale el dato&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Simulador&lt;/b&gt; &amp;nbsp;&lt;i&gt;simulator/&lt;/i&gt;&lt;br&gt;○ pendiente · #16 / #89 (Eduardo)&lt;br&gt;&lt;br&gt;Hace de sensor: cada N segundos envía una lectura. Hoy &lt;b&gt;main.py solo es un esqueleto&lt;/b&gt;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="250" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Hoy la alimentan&lt;/b&gt;&lt;br&gt;✔ tests pytest (TestClient)&lt;br&gt;✔ Swagger /docs o curl" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="250" height="90" as="geometry"/></mxCell><mxCell id="c6" value="2 · Backend FastAPI  (backend:8000)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="850" height="620" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ENTRADA · escribe&lt;/b&gt; (sin login)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#2d7600;" vertex="1" parent="1"><mxGeometry x="350" y="160" width="300" height="24" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;SALIDA · lee&lt;/b&gt; (siempre con sesión)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#1a4d8f;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="330" height="24" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;POST /api/readings&lt;/b&gt; &amp;nbsp;✔ #24&lt;br&gt;Valida el JSON con ReadingCreate&lt;br&gt;→ 422 si no encaja" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="350" y="200" width="300" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;ReadingService.create()&lt;/b&gt; &amp;nbsp;✔ #24&lt;br&gt;• ¿existe el sensor? si no → 404&lt;br&gt;• pressure → value, unit del sensor&lt;br&gt;• guarda dentro de transaction() → COMMIT" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="350" y="300" width="300" height="95" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Reglas LOW / HIGH_PRESSURE&lt;/b&gt; &amp;nbsp;◐ #28&lt;br&gt;En la misma transacción: abre o empeora la alerta. &lt;i&gt;PR #98 abierta.&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=4;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="350" y="425" width="300" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Regla SENSOR_OFFLINE&lt;/b&gt; &amp;nbsp;○ #28&lt;br&gt;Necesita &lt;i&gt;last_seen_at&lt;/i&gt;, que aún no existe (#97, Daruny)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;strokeWidth=4;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="350" y="525" width="300" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Auth&lt;/b&gt; &amp;nbsp;✔ #26 · register, login, logout, /api/me&lt;br&gt;&lt;b&gt;Permisos y organización&lt;/b&gt; &amp;nbsp;◐ #27&lt;br&gt;(filtro por organización ya aplicado; roles no)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="200" width="330" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;GET /api/sensors/{id}/readings&lt;/b&gt; &amp;nbsp;✔ #25&lt;br&gt;Histórico paginado de un sensor" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="330" height="55" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;GET /api/alerts&lt;/b&gt; · PATCH acknowledge / resolve&lt;br&gt;✔ #28 (PR #78)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=4;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="800" y="375" width="330" height="60" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;GET /api/sensors&lt;/b&gt; · &lt;b&gt;GET /api/sensors/{id}&lt;/b&gt;&lt;br&gt;○ #25 · el router existe sin rutas" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="800" y="455" width="330" height="55" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Sites&lt;/b&gt; y &lt;b&gt;POST / PATCH sensors&lt;/b&gt;&lt;br&gt;○ #29" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="800" y="530" width="330" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;font style='font-size:11px'&gt;Cada petición cruza tres capas: &lt;b&gt;router&lt;/b&gt; (solo HTTP) → &lt;b&gt;service&lt;/b&gt; (reglas, no sabe qué es un 404) → &lt;b&gt;repository&lt;/b&gt; (solo SQL, de Daruny).&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="350" y="640" width="780" height="60" as="geometry"/></mxCell><mxCell id="c19" value="3 · PostgreSQL  (tablas de Daruny, #13 y #18)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="770" width="850" height="170" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;sensors&lt;/b&gt; · &lt;b&gt;sites&lt;/b&gt; · &lt;b&gt;users&lt;/b&gt;&lt;br&gt;unit, low/high_threshold, site_id → organization_id&lt;br&gt;&lt;i&gt;○ falta last_seen_at (#97)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="350" y="820" width="220" height="95" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;readings&lt;/b&gt;&lt;br&gt;sensor_id, value, unit, recorded_at, created_at" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="610" y="820" width="220" height="95" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;alerts&lt;/b&gt;&lt;br&gt;status ACTIVE → RESOLVED&lt;br&gt;severity WARNING / CRITICAL&lt;br&gt;acknowledged_at, resolved_at" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=4;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="820" width="250" height="95" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;4 · Quién lo enseña&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1230" y="110" width="560" height="30" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Gateway Nginx&lt;/b&gt; &amp;nbsp;✔ #20&lt;br&gt;HTTPS :443&lt;br&gt;/api/ → backend:8000&lt;br&gt;/ws/ → reservado" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1230" y="200" width="220" height="95" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Frontend Vue&lt;/b&gt;&lt;br&gt;• Dashboard Admin ◐ #7 (Florinda)&lt;br&gt;• Dashboard Cliente ○ #39 (Lylia)&lt;br&gt;• Históricos ○ #40 (Lylia)&lt;br&gt;• Sensores y alertas Admin ○ #38&lt;br&gt;• Mapa de sites ○ #8&lt;br&gt;&lt;br&gt;&lt;i&gt;Hoy tira casi todo de mockAdapter (VITE_USE_MOCK): datos falsos con la misma forma que la API.&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1510" y="185" width="290" height="190" as="geometry"/></mxCell><mxCell id="c26" value="① POST /api/readings&lt;br&gt;directo a backend:8000&lt;br&gt;(red interna, sin Nginx ni login)" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="405"/><mxPoint x="320" y="256"/></Array></mxGeometry></mxCell><mxCell id="c28" value="②" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="③ SELECT sensor" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c10" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="335" y="347"/><mxPoint x="335" y="795"/><mxPoint x="460" y="795"/></Array></mxGeometry></mxCell><mxCell id="c30" value="④ INSERT + COMMIT" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7600;endArrow=block;endFill=1;" edge="1" parent="1" source="c10" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="347"/></Array></mxGeometry></mxCell><mxCell id="c31" value="⑤ (#28)" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;dashed=1;strokeColor=#d79b00;endArrow=block;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="abre / empeora alerta" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.32;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#d79b00;endArrow=block;endFill=1;" edge="1" parent="1" source="c11" target="c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="745" y="460"/><mxPoint x="745" y="760"/><mxPoint x="960" y="760"/></Array></mxGeometry></mxCell><mxCell id="c33" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=0.73;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1a4d8f;endArrow=block;endFill=1;" edge="1" parent="1" source="c21" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="780"/><mxPoint x="1145" y="780"/><mxPoint x="1145" y="327"/></Array></mxGeometry></mxCell><mxCell id="c34" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=0.64;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1a4d8f;endArrow=block;endFill=1;" edge="1" parent="1" source="c22" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="800"/><mxPoint x="1160" y="800"/><mxPoint x="1160" y="405"/></Array></mxGeometry></mxCell><mxCell id="c35" value="⑥ HTTPS + cookie de sesión" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c25" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="⑦ /api/…" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c24" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;El recorrido de un dato, en frase&lt;/b&gt;&lt;br&gt;&lt;br&gt;① El simulador mide y envía la lectura.&lt;br&gt;② El router valida el JSON y se la pasa al service.&lt;br&gt;③ El service comprueba que el sensor existe.&lt;br&gt;④ La guarda en &lt;i&gt;readings&lt;/i&gt; y la confirma (COMMIT) → &lt;b&gt;201&lt;/b&gt;.&lt;br&gt;⑤ Si la presión sale de los umbrales, abre una alerta (#28).&lt;br&gt;⑥ El usuario abre el dashboard, que llama por HTTPS.&lt;br&gt;⑦ Con sesión (#26) y solo de su organización (#27), lee histórico (#25) y alertas (#28).&lt;br&gt;&lt;br&gt;Lo de la izquierda escribe, lo de la derecha lee: &lt;b&gt;todo lo que se ve en el producto sale de lo que entra por ①–④ (#24).&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=10;strokeColor=#999999;fillColor=#fafafa;rounded=1;" vertex="1" parent="1"><mxGeometry x="1230" y="440" width="570" height="290" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="770" width="300" height="22" as="geometry"/></mxCell><mxCell id="c39" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1230" y="798" width="30" height="18" as="geometry"/></mxCell><mxCell id="c40" value="✔ hecho (en develop)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="796" width="300" height="22" as="geometry"/></mxCell><mxCell id="c41" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1230" y="824" width="30" height="18" as="geometry"/></mxCell><mxCell id="c42" value="◐ en curso / a medias" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="822" width="300" height="22" as="geometry"/></mxCell><mxCell id="c43" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1230" y="850" width="30" height="18" as="geometry"/></mxCell><mxCell id="c44" value="○ pendiente" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="848" width="300" height="22" as="geometry"/></mxCell><mxCell id="c45" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1230" y="876" width="30" height="18" as="geometry"/></mxCell><mxCell id="c46" value="infraestructura y frontend" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="874" width="300" height="22" as="geometry"/></mxCell><mxCell id="c47" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1230" y="902" width="30" height="18" as="geometry"/></mxCell><mxCell id="c48" value="base de datos" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="900" width="300" height="22" as="geometry"/></mxCell><mxCell id="c49" value="&lt;font style='font-size:11px'&gt;&lt;b&gt;Borde negro grueso = lo de la #28.&lt;/b&gt;&lt;br&gt;Flecha verde = escribe · azul = lee · naranja discontinua = #28, aún en PR.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1510" y="798" width="290" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
