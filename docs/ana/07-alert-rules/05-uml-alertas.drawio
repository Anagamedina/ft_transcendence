<mxfile host="app.diagrams.net"><diagram id="1___Clases" name="1 · Clases"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style='font-size:20px'&gt;&lt;b&gt;Issue #28 · reglas y endpoints de alertas — diagrama de clases&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Dos mitades: &lt;b&gt;generar&lt;/b&gt; alertas al recibir una lectura (PR #98, abierta) y &lt;b&gt;gestionarlas&lt;/b&gt; desde el dashboard (PR #78, en develop). SENSOR_OFFLINE sigue pendiente." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1770" height="70" as="geometry"/></mxCell><mxCell id="c3" value="«router · HTTP · PR #78»&lt;br&gt;&lt;b&gt;alerts/router.py  ·  /api/alerts&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="380" height="130" as="geometry"/></mxCell><mxCell id="c4" style="line;html=1;strokeWidth=1;" vertex="1" parent="c3"><mxGeometry y="44" width="380" height="8" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;+ list_alerts(user, pagination,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;status?, sensor_id?)&lt;/b&gt; → Page ★" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c3"><mxGeometry y="52" width="380" height="34" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;+ acknowledge_alert(alert_id, user)&lt;/b&gt; ★" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c3"><mxGeometry y="86" width="380" height="20" as="geometry"/></mxCell><mxCell id="c7" value