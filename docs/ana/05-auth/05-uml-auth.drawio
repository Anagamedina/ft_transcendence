<mxfile host="app.diagrams.net"><diagram id="1___Clases" name="1 · Clases"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style='font-size:20px'&gt;&lt;b&gt;Issue #26 · registro, login, logout y /api/me — diagrama de clases&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Sesión en una &lt;b&gt;cookie httpOnly firmada&lt;/b&gt; (ADR 0001) y contraseñas con &lt;b&gt;argon2&lt;/b&gt;. PRs #75 y #79." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1770" height="70" as="geometry"/></mxCell><mxCell id="c3" value="«router · HTTP»&lt;br&gt;&lt;b&gt;auth/router.py  ·  /api/auth&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="360" height="158" as="geometry"/></mxCell><mxCell id="c4" style="line;html=1;strokeWidth=1;" vertex="1" parent="c3"><mxGeometry y="44" width="360" height="8" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;+ login(payload, response, service)&lt;/b&gt; ★&lt;br&gt;&amp;nbsp;&amp;nbsp;→ SessionResponse + Set-Cookie" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c3"><mxGeometry y="52" width="360" height="34" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;+ logout(response, service)&lt;/b&gt; ★&lt;br&gt;&amp;nbsp;&amp;nbsp;→ MessageResponse + borra la cookie" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c3"><mxGeometry y="86" width="360" height="34" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;+ register(payload, service, user: CurrentUser)&lt;/b&gt; ★&lt;br&gt;&amp;nbsp;&amp;nbsp;→ 201 · solo admin (403 si no)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c3"><mxGeometry y="120" width="360" height="34" as="geometry"/></mxCell><mxCell id="c8" value="«router · HTTP»&lt;br&gt;&lt;b&gt;users/router.py&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="308" width="360" height="90" as="geometry"/></mxCell><mxCell id="c9" style="line;html=1;strokeWidth=1;" vertex="1" parent="c8"><mxGeometry y="44" width="360" height="8" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;+ get_me(service, user: CurrentUser)&lt;/b&gt; ★&lt;br&gt;&amp;nbsp;&amp;nbsp;→ SessionResponse" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c8"><mxGeometry y="52" width="360" height="34" as="geometry"/></mxCell><mxCell id="c11" value="«schemas»&lt;br&gt;&lt;b&gt;auth/schemas.py&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="428" width="360" height="136" as="geometry"/></mxCell><mxCell id="c12" value="LoginRequest: email, password" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c11"><mxGeometry y="44" width="360" height="20" as="geometry"/></mxCell><mxCell id="c13" value="RegisterRequest: email, name, password…" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c11"><mxGeometry y="64" width="360" height="20" as="geometry"/></mxCell><mxCell id="c14" value="SessionResponse: user: UserResponse" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c11"><mxGeometry y="84" width="360" height="20" as="geometry"/></mxCell><mxCell id="c15" value="MessageResponse: message" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c11"><mxGeometry y="104" width="360" height="20" as="geometry"/></mxCell><mxCell id="c16" style="line;html=1;strokeWidth=1;" vertex="1" parent="c11"><mxGeometry y="124" width="360" height="8" as="geometry"/></mxCell><mxCell id="c17" value="«service · reglas de negocio»&lt;br&gt;&lt;b&gt;AuthService&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="490" y="120" width="400" height="156" as="geometry"/></mxCell><mxCell id="c18" value="- users: UserRepository" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c17"><mxGeometry y="44" width="400" height="20" as="geometry"/></mxCell><mxCell id="c19" value="- _HUELLA_SENUELO  (hash ficticio)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c17"><mxGeometry y="64" width="400" height="20" as="geometry"/></mxCell><mxCell id="c20" style="line;html=1;strokeWidth=1;" vertex="1" parent="c17"><mxGeometry y="84" width="400" height="8" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;+ login(payload) → UserResponse&lt;/b&gt; ★" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c17"><mxGeometry y="92" width="400" height="20" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;+ register(payload, organization_id, role)&lt;/b&gt; ★" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c17"><mxGeometry y="112" width="400" height="20" as="geometry"/></mxCell><mxCell id="c23" value="+ logout()  → no hace nada (ver nota)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c17"><mxGeometry y="132" width="400" height="20" as="geometry"/></mxCell><mxCell id="c24" value="«dependency · shared/dependencies.py»&lt;br&gt;&lt;b&gt;get_current_user(request, db) → User&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="490" y="306" width="400" height="136" as="geometry"/></mxCell><mxCell id="c25" style="line;html=1;strokeWidth=1;" vertex="1" parent="c24"><mxGeometry y="44" width="400" height="8" as="geometry"/></mxCell><mxCell id="c26" value="1. lee la cookie aquaguard_session" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c24"><mxGeometry y="52" width="400" height="20" as="geometry"/></mxCell><mxCell id="c27" value="2. read_session_token() → user_id | None" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c24"><mxGeometry y="72" width="400" height="20" as="geometry"/></mxCell><mxCell id="c28" value="3. UserRepository.get(user_id)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c24"><mxGeometry y="92" width="400" height="20" as="geometry"/></mxCell><mxCell id="c29" value="cualquier fallo → 401" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c24"><mxGeometry y="112" width="400" height="20" as="geometry"/></mxCell><mxCell id="c30" value="«core/exceptions.py»&lt;br&gt;&lt;b&gt;Errores de dominio&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="490" y="472" width="400" height="116" as="geometry"/></mxCell><mxCell id="c31" value="UnauthorizedError → 401 UNAUTHORIZED" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c30"><mxGeometry y="44" width="400" height="20" as="geometry"/></mxCell><mxCell id="c32" value="ForbiddenError → 403 FORBIDDEN" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c30"><mxGeometry y="64" width="400" height="20" as="geometry"/></mxCell><mxCell id="c33" value="ConflictError → 409 EMAIL_ALREADY_EXISTS" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c30"><mxGeometry y="84" width="400" height="20" as="geometry"/></mxCell><mxCell id="c34" style="line;html=1;strokeWidth=1;" vertex="1" parent="c30"><mxGeometry y="104" width="400" height="8" as="geometry"/></mxCell><mxCell id="c35" value="«utilidad · sin estado»&lt;br&gt;&lt;b&gt;core/security.py&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="980" y="120" width="420" height="230" as="geometry"/></mxCell><mxCell id="c36" value="SESSION_COOKIE = &amp;quot;aquaguard_session&amp;quot;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c35"><mxGeometry y="44" width="420" height="20" as="geometry"/></mxCell><mxCell id="c37" value="SESSION_MAX_AGE_SECONDS = 8 h" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c35"><mxGeometry y="64" width="420" height="20" as="geometry"/></mxCell><mxCell id="c38" style="line;html=1;strokeWidth=1;" vertex="1" parent="c35"><mxGeometry y="84" width="420" height="8" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;+ hash_password(pwd)&lt;/b&gt;  argon2 ★" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c35"><mxGeometry y="92" width="420" height="20" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;+ verify_password(pwd, hash) → bool&lt;/b&gt; ★" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c35"><mxGeometry y="112" width="420" height="20" as="geometry"/></mxCell><mxCell id="c41" value="+ needs_rehash(hash) → bool ★" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c35"><mxGeometry y="132" width="420" height="20" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;+ create_session_token(user_id) → str&lt;/b&gt;  firmado ★" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c35"><mxGeometry y="152" width="420" height="20" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;+ read_session_token(token) → UUID | None&lt;/b&gt; ★" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c35"><mxGeometry y="172" width="420" height="20" as="geometry"/></mxCell><mxCell id="c44" value="+ session_cookie_kwargs()  httponly, secure,&lt;br&gt;&amp;nbsp;&amp;nbsp;samesite=lax, path=/" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c35"><mxGeometry y="192" width="420" height="34" as="geometry"/></mxCell><mxCell id="c45" value="«implementación · Daruny»&lt;br&gt;&lt;b&gt;users/repository.py&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="980" y="380" width="420" height="136" as="geometry"/></mxCell><mxCell id="c46" style="line;html=1;strokeWidth=1;" vertex="1" parent="c45"><mxGeometry y="44" width="420" height="8" as="geometry"/></mxCell><mxCell id="c47" value="+ get_by_email(email)  (normaliza el email)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c45"><mxGeometry y="52" width="420" height="20" as="geometry"/></mxCell><mxCell id="c48" value="+ get(user_id)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c45"><mxGeometry y="72" width="420" height="20" as="geometry"/></mxCell><mxCell id="c49" value="+ get_by_id(user_id, organization_id)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c45"><mxGeometry y="92" width="420" height="20" as="geometry"/></mxCell><mxCell id="c50" value="+ create(...)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c45"><mxGeometry y="112" width="420" height="20" as="geometry"/></mxCell><mxCell id="c51" value="«tabla users»&lt;br&gt;&lt;b&gt;User&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1490" y="120" width="310" height="196" as="geometry"/></mxCell><mxCell id="c52" value="+ id: UUID" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c51"><mxGeometry y="44" width="310" height="20" as="geometry"/></mxCell><mxCell id="c53" value="+ organization_id: UUID | None" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c51"><mxGeometry y="64" width="310" height="20" as="geometry"/></mxCell><mxCell id="c54" value="+ email: str" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c51"><mxGeometry y="84" width="310" height="20" as="geometry"/></mxCell><mxCell id="c55" value="+ name: str" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c51"><mxGeometry y="104" width="310" height="20" as="geometry"/></mxCell><mxCell id="c56" value="+ password_hash: str" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c51"><mxGeometry y="124" width="310" height="20" as="geometry"/></mxCell><mxCell id="c57" value="+ role: &amp;quot;admin&amp;quot; | &amp;quot;client&amp;quot;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c51"><mxGeometry y="144" width="310" height="20" as="geometry"/></mxCell><mxCell id="c58" value="+ created_at, updated_at" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c51"><mxGeometry y="164" width="310" height="20" as="geometry"/></mxCell><mxCell id="c59" style="line;html=1;strokeWidth=1;" vertex="1" parent="c51"><mxGeometry y="184" width="310" height="8" as="geometry"/></mxCell><mxCell id="c60" value="«tabla organizations»&lt;br&gt;&lt;b&gt;Organization&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1490" y="346" width="310" height="96" as="geometry"/></mxCell><mxCell id="c61" value="+ id: UUID" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c60"><mxGeometry y="44" width="310" height="20" as="geometry"/></mxCell><mxCell id="c62" value="+ name" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c60"><mxGeometry y="64" width="310" height="20" as="geometry"/></mxCell><mxCell id="c63" style="line;html=1;strokeWidth=1;" vertex="1" parent="c60"><mxGeometry y="84" width="310" height="8" as="geometry"/></mxCell><mxCell id="c64" value="Depends" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c3" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c65" value="register usa" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c3" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c66" value="Depends" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c8" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c67" value="hash / verify" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c17" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c69" value="read_session_token" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c24" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c70" value="users" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;endArrow=open;endFill=0;" edge="1" parent="1" source="c17" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c71" value="get(user_id)" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c24" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c72" value="lee / escribe" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c45" target="c51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c73" value="1 ── 0..*" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="c60" target="c51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c74" value="&lt;b&gt;La cookie solo lleva el id del usuario&lt;/b&gt;&lt;br&gt;Rol y organización se leen de la base &lt;b&gt;en cada petición&lt;/b&gt; (paso 3 de get_current_user). Así, cambiarle el rol a alguien o darlo de baja se nota en su siguiente petición, sin esperar a que vuelva a entrar." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="490" y="700" width="400" height="140" as="geometry"/></mxCell><mxCell id="c75" value="&lt;b&gt;Login con un email que no existe&lt;/b&gt;&lt;br&gt;Se verifica igualmente contra un hash señuelo antes de responder 401. Si no, «no existe» respondería más rápido que «contraseña mala», y midiendo el tiempo se sabría qué cuentas hay dadas de alta." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="980" y="700" width="420" height="140" as="geometry"/></mxCell><mxCell id="c76" value="&lt;b&gt;Logout no puede revocar&lt;/b&gt;&lt;br&gt;La sesión es una cookie firmada &lt;b&gt;sin estado&lt;/b&gt;: el servidor no guarda una lista de sesiones, solo comprueba firma y fecha. Logout borra la cookie del navegador, pero una copia sigue valiendo hasta que caduca (8 h).&lt;br&gt;&lt;br&gt;Se asume para el MVP. Si hiciera falta, la revocación iría dentro de AuthService.logout() sin tocar el router." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1490" y="550" width="310" height="250" as="geometry"/></mxCell><mxCell id="c77" value="&lt;b&gt;No hay registro público&lt;/b&gt;&lt;br&gt;El equipo acordó que las cuentas de cliente las crea un admin, dentro de su organización. Por eso register exige sesión y no abre sesión para el usuario creado." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="490" y="870" width="400" height="110" as="geometry"/></mxCell><mxCell id="c78" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="300" height="20" as="geometry"/></mxCell><mxCell id="c79" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="748" width="30" height="18" as="geometry"/></mxCell><mxCell id="c80" value="escrito o cambiado en esta issue (★ = nuevo)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="746" width="330" height="22" as="geometry"/></mxCell><mxCell id="c81" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="774" width="30" height="18" as="geometry"/></mxCell><mxCell id="c82" value="ya existía" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="772" width="330" height="22" as="geometry"/></mxCell><mxCell id="c83" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="30" height="18" as="geometry"/></mxCell><mxCell id="c84" value="contrato (Protocol)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="798" width="330" height="22" as="geometry"/></mxCell><mxCell id="c85" value="" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="826" width="30" height="18" as="geometry"/></mxCell><mxCell id="c86" value="modelo / tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="824" width="330" height="22" as="geometry"/></mxCell><mxCell id="c87" value="" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="852" width="30" height="18" as="geometry"/></mxCell><mxCell id="c88" value="error de dominio" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="850" width="330" height="22" as="geometry"/></mxCell><mxCell id="c89" value="&lt;font style='font-size:11px'&gt;- - -▷ &amp;nbsp;cumple el contrato (realización)&lt;br&gt;- - -&amp;gt; &amp;nbsp;depende de / usa&lt;br&gt;——&amp;gt; &amp;nbsp;tiene una referencia (asociación)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="882" width="380" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2___Secuencia" name="2 · Secuencia"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1930" pageHeight="1548" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L0" value="Navegador" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="160" height="1398" as="geometry"/></mxCell><mxCell id="L1" value="auth / users router" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="270" y="110" width="160" height="1398" as="geometry"/></mxCell><mxCell id="L2" value="get_current_user" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="480" y="110" width="160" hei