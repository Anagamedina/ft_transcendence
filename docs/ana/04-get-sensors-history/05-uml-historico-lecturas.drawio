eWidth=1;" vertex="1" parent="c28"><mxGeometry y="64" width="380" height="8" as="geometry"/></mxCell><mxCell id="c31" value="mismo error si no existe o es de otra org." style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c28"><mxGeometry y="72" width="380" height="20" as="geometry"/></mxCell><mxCell id="c32" value="«Protocol · shared/protocols.py»&lt;br&gt;&lt;b&gt;SensorRepository&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="940" y="120" width="400" height="96" as="geometry"/></mxCell><mxCell id="c33" style="line;html=1;strokeWidth=1;" vertex="1" parent="c32"><mxGeometry y="44" width="400" height="8" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;+ get_by_id(sensor_id, organization_id)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c32"><mxGeometry y="52" width="400" height="20" as="geometry"/></mxCell><mxCell id="c35" value="+ get(sensor_id)  (solo el simulador, #24)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c32"><mxGeometry y="72" width="400" height="20" as="geometry"/></mxCell><mxCell id="c36" value="«Protocol · shared/protocols.py»&lt;br&gt;&lt;b&gt;ReadingRepository&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="940" y="270" width="400" height="90" as="geometry"/></mxCell><mxCell id="c37" style="line;html=1;strokeWidth=1;" vertex="1" parent="c36"><mxGeometry y="44" width="400" height="8" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;+