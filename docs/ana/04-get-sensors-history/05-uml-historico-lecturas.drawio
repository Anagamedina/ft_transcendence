<mxfile host="app.diagrams.net"><diagram id="1___Clases" name="1 · Clases"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style='font-size:20px'&gt;&lt;b&gt;Issue #25 · GET /api/sensors/{id}/readings — diagrama de clases&lt;/b&gt;&lt;/font&gt;&lt;br&gt;El histórico de un sensor: paginado, ordenado por fecha de medida y &lt;b&gt;solo de tu organización&lt;/b&gt; (PR #77). Los otros dos GET de la issue siguen pendientes." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1770" height="70" as="geometry"/></mxCell><mxCell id="c3" value="«router · HTTP»&lt;br&gt;&lt;b&gt;readings/router.py&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="330" height="90" as="geometry"/></mxCell><mxCell id="c4" style="line;html=1;strokeWidth=1;" vertex="1" parent="c3"><mxGeometry y="44" width="330" height="8" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;+ list_sensor_readings(sensor_id, service,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;user: CurrentUser, pagination)&lt;/b&gt; ★" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c3"><mxGeometry y="52" width="330" height="34" as="geometry"/></mxCell><mxCell id="c6" value="«dependency · shared/dependencies.py»&lt;br&gt;&lt;b&gt;PaginationParams&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="330" height="136" as="geometry"/></mxCell><mxCell id="c7" value="+ page: int ≥ 1 &amp;nbsp;(por defecto 1)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c6"><mxGeometry y="44" width="330" height="20" as="geometry"/></mxCell><mxCell id="c8" value="+ page_size: int 1–100 &amp;nbsp;(por defecto 20)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c6"><mxGeometry y="64" width="330" height="20" as="geometry"/></mxCell><mxCell id="c9" style="line;html=1;strokeWidth=1;" vertex="1" parent="c6"><mxGeometry y="84" width="330" height="8" as="geometry"/></mxCell><mxCell id="c10" value="+ offset = (page − 1) · page_size" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c6"><mxGeometry y="92" width="330" height="20" as="geometry"/></mxCell><mxCell id="c11" value="+ limit = page_size" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c6"><mxGeometry y="112" width="330" height="20" as="geometry"/></mxCell><mxCell id="c12" value="«schema de salida»&lt;br&gt;&lt;b&gt;Page[ReadingResponse]&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="330" height="136" as="geometry"/></mxCell><mxCell id="c13" value="+ items: list[ReadingResponse]" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c12"><mxGeometry y="44" width="330" height="20" as="geometry"/></mxCell><mxCell id="c14" value="+ total: int" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c12"><