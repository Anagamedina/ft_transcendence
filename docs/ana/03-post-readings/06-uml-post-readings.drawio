"1" as="geometry"></mxGeometry></mxCell><mxCell id="c73" value="usa" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c18" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c75" value="cumple" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=block;endFill=0;endSize=12;" edge="1" parent="1" source="c43" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c76" value="cumple" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=block;endFill=0;endSize=12;" edge="1" parent="1" source="c47" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c77" value="lee" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c47" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c78" value="escribe" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c43" target="c59"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1800" y="172"/><mxPoint x="1800" y="740"/></Array></mxGeometry></mxCell><mxCell id="c79" value="1 ── 0..*" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;endArrow=none;" edge="1" parent="1" source="c52" target="c59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c80" value="&lt;b&gt;Traducción de vocabulario (la hace el service)&lt;/b&gt;&lt;br&gt;API &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ tabla&lt;br&gt;pressure &amp;nbsp;&amp;nbsp;&amp;nbsp;→ value&lt;br&gt;measured_at → recorded_at&lt;br&gt;(no viene) &amp;nbsp;→ unit = &lt;i&gt;sensor.unit&lt;/i&gt;&lt;br&gt;&lt;br&gt;El service lanza NotFoundError y no sabe qué es un 404." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="440" y="700" width="380" height="150" as="geometry"/></mxCell><mxCell id="c81" value="&lt;b&gt;¿Por qué Protocol?&lt;/b&gt;&lt;br&gt;El service declara &lt;i&gt;qué métodos&lt;/i&gt; necesita sin importar la clase de Daruny. Sus repositories cumplen el contrato por tener esos métodos.&lt;br&gt;Coste: nadie comprueba que las firmas coincidan hasta que se juntan. En #24 no coincidían y se alinearon." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="920" y="450" width="400" height="150" as="geometry"/></mxCell><mxCell id="c82" value="&lt;b&gt;¿Por qué get() sin organización?&lt;/b&gt;&lt;br&gt;Quien llama es el simulador: no hace login y no tiene organización. Para lo que pide un usuario con sesión se sigue usando get_by_id()." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="920" y="630" width="400" height="110" as="geometry"/></mxCell><mxCell id="c83" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="300" height="20" as="geometry"/></mxCell><mxCell id="c84" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="788" width="30" height="18" as="geometry"/></mxCell><mxCell id="c85" value="escrito o cambiado en #24 (★ = método nuevo)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="786" width="320" height="22" as="geometry"/></mxCell><mxCell id="c86" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="814" width="30" height="18" as="geometry"/></mxCell><mxCell id="c87" value="ya existía (#22, #23, #14)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="812" width="320" height="22" as="geometry"/></mxCell><mxCell id="c88" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="30" height="18" as="geometry"/></mxCell><mxCell id="c89" value="contrato (Protocol)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="838" width="320" height="22" as="geometry"/></mxCell><mxCell id="c90" value="" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="866" width="30" height="18" as="geometry"/></mxCell><mxCell id="c91" value="modelo / tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="864" width="320" height="22" as="geometry"/></mxCell><mxCell id="c92" value="" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="892" width="30" height="18" as="geometry"/></mxCell><mxCell id="c93" value="error de dominio" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="890" width="320" height="22" as="geometry"/></mxCell><mxCell id="c94" value="&lt;font style='font-size:11px'&gt;- - -▷ &amp;nbsp;cumple el contrato (realización)&lt;br&gt;- - -&amp;gt; &amp;nbsp;depende de / usa&lt;br&gt;——&amp;gt; &amp;nbsp;tiene una referencia (asociación)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="360" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2_·_Secuencia" name="2 · Secuencia"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c95" value="&lt;font style='font-size:20px'&gt;&lt;b&gt;Issue #24 · POST /api/readings — diagrama de secuencia&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Qué pasa, en orden, desde que el simulador envía una lectura hasta que recibe el 201" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="60" as="geometry"/></mxCell><mxCell id="c96" value="Simulador" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="150" height="1020" as="geometry"/></mxCell><mxCell id="c97" value="FastAPI&lt;br&gt;(validación)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="150" height="1020" as="geometry"/></mxCell><mxCell id="c98" value="readings router" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="150" height="1020" as="geometry"/></mxCell><mxCell id="c99" value="ReadingService" style="shape=umlLifeline;perimeter=lifelinePeri