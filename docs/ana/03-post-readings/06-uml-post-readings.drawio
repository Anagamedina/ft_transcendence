idth="12" height="570" as="geometry"/></mxCell><mxCell id="c113" value="4. sensors.get(sensor_id)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="711.0" y="380" as="sourcePoint"/><mxPoint x="889.0" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c114" value="" style="html=1;points=[];fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="889.0" y="380" width="12" height="60" as="geometry"/></mxCell><mxCell id="c115" value="SELECT … FROM sensors" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="901.0" y="405" as="sourcePoint"/><mxPoint x="1459.0" y="405" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c116" value="Sensor | None" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="889.0" y="440" as="sourcePoint"/><mxPoint x="711.0" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c117" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=22;fontSize=11;fontStyle=1;fillColor=none;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="75.0" y="460" width="890.0" height="80" as="geometry"/></mxCell><mxCell id="c118" value="&lt;i&gt;[no existe el sensor]&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="131.0" y="462" width="830.0" height="20" as="geometry"/></mxCell><mxCell id="c119" value="raise NotFoundError(SENSOR_NOT_FOUND)  →  404" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="699.0" y="515" as="sourcePoint"/><mxPoint x="141.0" y="515" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c120" value="5. _resolve_measured_at()&lt;br&gt;el que venga, o ahora (UTC)" style="html=1;align=left;spacingLeft=4;fontSize=11;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="711.0" y="560" as="sourcePoint"/><mxPoint x="717.0" y="586" as="targetPoint"/><Array as="points"><mxPoint x="751.0" y="560"/><mxPoint x="751.0" y="586"/></Array></mxGeometry></mxCell><mxCell id="c121" value="&lt;b&gt;6. with transaction(db):&lt;/b&gt;" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="711.0" y="630" as="sourcePoint"/><mxPoint x="1079.0" y="630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c122" value="" style="html=1;points=[];fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1079.0" y="630" width="12" height="170" as="geometry"/></mxCell><mxCell id="c123" value="7. readings.create(sensor_id, value=pressure,&lt;br&gt;unit=sensor.unit, recorded_at)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="711.0" y="670" as="sourcePoint"/><mxPoint x="1269.0" y="670" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c124" value="" style="html=1;points=[];fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1269.0" y="670" width="12" height="60" as="geometry"/></mxCell><mxCell id="c125" value="INSERT … + flush()" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1281.0" y="700" as="sourcePoint"/><mxPoint x="1459.0" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c126" value="Reading" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1269.0" y="730" as="sourcePoint"/><mxPoint x="711.0" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c127" value="&lt;b&gt;8. COMMIT  (al salir del with)&lt;/b&gt;" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1091.0" y="780" as="sourcePoint"/><mxPoint x="1459.0" y="780" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c128" value="9. _to_response(reading)&lt;br&gt;value→pressure, recorded_at→measured_at" style="html=1;align=left;spacingLeft=4;fontSize=11;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="711.0" y="840" as="sourcePoint"/><mxPoint x="717.0" y="866" as="targetPoint"/><Array as="points"><mxPoint x="751.0" y="840"/><mxPoint x="751.0" y="866"/></Array></mxGeometry></mxCell><mxCell id="c129" value="ReadingResponse" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="699.0" y="900" as="sourcePoint"/><mxPoint x="521.0" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c130" value="&lt;b&gt;201 Created + ReadingResponse&lt;/b&gt;" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="509.0" y="930" as="sourcePoint"/><mxPoint x="141.0" y="930" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c131" value="&lt;b&gt;El fallo que evita el paso 8&lt;/b&gt;&lt;br&gt;get_db() solo cierra la sesión y el repository solo hace flush(). Sin transaction() la API devolvía &lt;b&gt;201 con su id y la fila se perdía&lt;/b&gt; al terminar la petición.&lt;br&gt;&lt;br&gt;El commit lo decide el caso de uso, o sea el service." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1580" y="620" width="300" height="190" as="geometry"/></mxCell><mxCell id="c132" value="&lt;b&gt;Fuera de esta issue&lt;/b&gt;&lt;br&gt;• last_seen_at: la columna no existe (ticket para Daruny)&lt;br&gt;• evaluar umbrales y crear alertas: issue #28" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1580" y="360" width="300" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3___Flujo_global" name="3 · Flujo global"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style='font-size:22px'&gt;&lt;b&gt;AquaGuard · dónde encaja la #24&lt;/b&gt;&lt;/font&gt;&lt;br&gt;El recorrido de una lectura, desde el simulador hasta el dashboard. Lo que toca la #24 va con &lt;b&gt;borde negro grueso&lt;/b&gt;." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1770" height="70" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;1 · De dónde sale el dato&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Simulador&lt;/b&gt; &amp;nbsp;&lt;i&gt;simulator/&lt;/i&gt;&lt;br&gt;○ pendiente · #16 / #89 (Eduardo)&lt;br&gt;&lt;br&gt;Hace de sensor: cada N segundos envía una lectura. Hoy &lt;b&gt;main.py solo es un esqueleto&lt;/b&gt;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="250" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Hoy la alimentan&lt;/b&gt;&lt;br&gt;✔ tests pytest (TestClient)&lt;br&gt;✔ Swagger /docs o curl" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="250" height="90" as="geometry"/></mxCell><mxCell id="c6" value="2 · Backend FastAPI  (backend:8000)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="850" height="620" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ENTRADA · escribe&lt;/b&gt; (sin login)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#2d7600;" vertex="1" parent="1"><mxGeometry x="350" y="160" width="300" height="24" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;SALIDA · lee&lt;/b&gt; (siempre con sesión)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#1a4d8f;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="330" height="24" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;POST /api/readings&lt;/b&gt; &amp;nbsp;✔ #24&lt;br&gt;Valida el JSON con ReadingCreate&lt;br&gt;→ 422 si no encaja" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=4;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="350" y="200" width="300" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;ReadingService.create()&lt;/b&gt; &amp;nbsp;✔ #24&lt;br&gt;• ¿existe el sensor? si no → 404&lt;br&gt;• pressure → value, unit del sensor&lt;br&gt;• guarda dentro de transaction() → COMMIT" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=4;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="350" y="300" width="300" height="95" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Reglas LOW / HIGH_PRESSURE&lt;/b&gt; &amp;nbsp;◐ #28&lt;br&gt;En la misma transacción: abre o empeora la alerta. &lt;i&gt;PR #98 abierta.&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="425" width="300" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Regla SENSOR_OFFLINE&lt;/b&gt; &amp;nbsp;○ #28&lt;br&gt;Necesita &lt;i&gt;last_seen_at&lt;/i&gt;, que aún no existe (#97, Daruny)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="350" y="525" width="300" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Auth&lt;/b&gt; &amp;nbsp;✔ #26 · register, login, logout, /api/me&lt;br&gt;&lt;b&gt;Permisos y organización&lt;/b&gt; &amp;nbsp;◐ #27&lt;br&gt;(filtro por organización ya aplicado; roles no)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="200" width="330" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;GET /api/sensors/{id}/readings&lt;/b&gt; &amp;nbsp;✔ #25&lt;br&gt;Histórico paginado de un sensor" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="330" height="55" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;GET /api/alerts&lt;/b&gt; · PATCH acknowledge / resolve&lt;br&gt;✔ #28 (PR #78)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="375" width="330" height="60" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;GET /api/sensors&lt;/b&gt; · &lt;b&gt;GET /api/sensors/{id}&lt;/b&gt;&lt;br&gt;○ #25 · el router existe sin rutas" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="800" y="455" width="330" height="55" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Sites&lt;/b&gt; y &lt;b&gt;POST / PATCH sensors&lt;/b&gt;&lt;br&gt;○ #29" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="800" y="530" width="330" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;font style='font-size:11px'&gt;Cada petición cruza tres capas: &lt;b&gt;router&lt;/b&gt; (solo HTTP) → &lt;b&gt;service&lt;/b&gt; (reglas, no sabe qué es un 404) → &lt;b&gt;repository&lt;/b&gt; (solo SQL, de Daruny).&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="350" y="640" width="780" height="60" as="geometry"/></mxCell><mxCell id="c19" value="3 · PostgreSQL  (tablas de Daruny, #13 y #18)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="770" width="850" height="170" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;sensors&lt;/b&gt; · &lt;b&gt;sites&lt;/b&gt; · &lt;b&gt;users&lt;/b&gt;&lt;br&gt;unit, low/high_threshold, site_id → organization_id&lt;br&gt;&lt;i&gt;○ falta last_seen_at (#97)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=4;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="350" y="820" width="220" height="95" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;readings&lt;/b&gt;&lt;br&gt;sensor_id, value, unit, recorded_at, created_at" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=4;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="820" width="220" height="95" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;alerts&lt;/b&gt;&lt;br&gt;status ACTIVE → RESOLVED&lt;br&gt;severity WARNING / CRITICAL&lt;br&gt;acknowledged_at, resolved_at" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="880" y="820" width="250" height="95" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;4 · Quién lo enseña&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1230" y="110" width="560" height="30" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Gateway Nginx&lt;/b&gt; &amp;nbsp;✔ #20&lt;br&gt;HTTPS :443&lt;br&gt;/api/ → backend:8000&lt;br&gt;/ws/ → reservado" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1230" y="200" width="220" height="95" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Frontend Vue&lt;/b&gt;&lt;br&gt;• Dashboard Admin ◐ #7 (Florinda)&lt;br&gt;• Dashboard Cliente ○ #39 (Lylia)&lt;br&gt;• Históricos ○ #40 (Lylia)&lt;br&gt;• Sensores y alertas Admin ○ #38&lt;br&gt;• Mapa de sites ○ #8&lt;br&gt;&lt;br&gt;&lt;i&gt;Hoy tira casi todo de mockAdapter (VITE_USE_MOCK): datos falsos con la misma forma que la API.&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1510" y="185" width="290" height="190" as="geometry"/></mxCell><mxCell id="c26" value="① POST /api/readings&lt;br&gt;directo a backend:8000&lt;br&gt;(red interna, sin Nginx ni login)" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="405"/><mxPoint x="320" y="256"/></Array></mxGeometry></mxCell><mxCell id="c28" value="②" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="③ SELECT sensor" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c10" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="335" y="347"/><mxPoint x="335" y="795"/><mxPoint x="460" y="795"/></Array></mxGeometry></mxCell><mxCell id="c30" value="④ INSERT + COMMIT" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7600;endArrow=block;endFill=1;" edge="1" parent="1" source="c10" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="347"/></Array></mxGeometry></mxCell><mxCell id="c31" value="⑤ (#28)" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;dashed=1;strokeColor=#d79b00;endArrow=block;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="abre / empeora alerta" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.32;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#d79b00;endArrow=block;endFill=1;" edge="1" parent="1" source="c11" target="c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="745" y="460"/><mxPoint x="745" y="760"/><mxPoint x="960" y="760"/></Array></mxGeometry></mxCell><mxCell id="c33" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=0.73;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1a4d8f;endArrow=block;endFill=1;" edge="1" parent="1" source="c21" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="780"/><mxPoint x="1145" y="780"/><mxPoint x="1145" y="327"/></Array></mxGeometry></mxCell><mxCell id="c34" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=0.64;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1a4d8f;endArrow=block;endFill=1;" edge="1" parent="1" source="c22" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="800"/><mxPoint x="1160" y="800"/><mxPoint x="1160" y="405"/></Array></mxGeometry></mxCell><mxCell id="c35" value="⑥ HTTPS + cookie de sesión" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c25" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="⑦ /api/…" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c24" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;El recorrido de un dato, en frase&lt;/b&gt;&lt;br&gt;&lt;br&gt;① El simulador mide y envía la lectura.&lt;br&gt;② El router valida el JSON y se la pasa al service.&lt;br&gt;③ El service comprueba que el sensor existe.&lt;br&gt;④ La guarda en &lt;i&gt;readings&lt;/i&gt; y la confirma (COMMIT) → &lt;b&gt;201&lt;/b&gt;.&lt;br&gt;⑤ Si la presión sale de los umbrales, abre una alerta (#28).&lt;br&gt;⑥ El usuario abre el dashboard, que llama por HTTPS.&lt;br&gt;⑦ Con sesión (#26) y solo de su organización (#27), lee histórico (#25) y alertas (#28).&lt;br&gt;&lt;br&gt;Lo de la izquierda escribe, lo de la derecha lee: &lt;b&gt;todo lo que se ve en el producto sale de lo que entra por ①–④ (#24).&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=10;strokeColor=#999999;fillColor=#fafafa;rounded=1;" vertex="1" parent="1"><mxGeometry x="1230" y="440" width="570" height="290" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="770" width="300" height="22" as="geometry"/></mxCell><mxCell id="c39" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1230" y="798" width="30" height="18" as="geometry"/></mxCell><mxCell id="c40" value="✔ hecho (en develop)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="796" width="300" height="22" as="geometry"/></mxCell><mxCell id="c41" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1230" y="824" width="30" height="18" as="geometry"/></mxCell><mxCell id="c42" value="◐ en curso / a medias" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="822" width="300" height="22" as="geometry"/></mxCell><mxCell id="c43" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1230" y="850" width="30" height="18" as="geometry"/></mxCell><mxCell id="c44" value="○ pendiente" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="848" width="300" height="22" as="geometry"/></mxCell><mxCell id="c45" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1230" y="876" width="30" height="18" as="geometry"/></mxCell><mxCell id="c46" value="infraestructura y frontend" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="874" width="300" height="22" as="geometry"/></mxCell><mxCell id="c47" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1230" y="902" width="30" height="18" as="geometry"/></mxCell><mxCell id="c48" value="base de datos" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="900" width="300" height="22" as="geometry"/></mxCell><mxCell id="c49" value="&lt;font style='font-size:11px'&gt;&lt;b&gt;Borde negro grueso = lo de la #24.&lt;/b&gt;&lt;br&gt;Flecha verde = escribe · azul = lee · naranja discontinua = #28, aún en PR.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1510" y="798" width="290" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
