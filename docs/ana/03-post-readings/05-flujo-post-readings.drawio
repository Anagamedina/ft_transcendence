  <diagram name="2 · Las tres capas y la frontera" id="capas24">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="c0" />
        <mxCell id="c1" parent="c0" />

        <mxCell id="ctit" value="Las tres capas — y por qué el service no sabe qué es un 404" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#0c2340;align=left;" vertex="1" parent="c1">
          <mxGeometry x="40" y="25" width="900" height="36" as="geometry" />
        </mxCell>

        <mxCell id="cap1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4f0f7;strokeColor=#0369a1;strokeWidth=2;" vertex="1" parent="c1">
          <mxGeometry x="60" y="110" width="1000" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cap1t" value="&lt;b&gt;ROUTER&lt;/b&gt;&amp;nbsp; — habla HTTP&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;readings/router.py&lt;/font&gt;" style="text;html=1;fontSize=16;fontColor=#0c2340;align=left;verticalAlign=top;" vertex="1" parent="c1">
          <mxGeometry x="80" y="125" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cap1c" value="Recibe JSON · declara los códigos 201/404/422/501 · convierte la excepción del service en respuesta HTTP.&lt;br&gt;&lt;br&gt;&lt;b&gt;✔ Ya está terminado.&lt;/b&gt; No tienes que tocarlo en la #24." style="text;html=1;fontSize=13;fontColor=#0c2340;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="c1">
          <mxGeometry x="80" y="185" width="960" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cap2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0369a1;strokeColor=#0c2340;strokeWidth=2;" vertex="1" parent="c1">
          <mxGeometry x="60" y="300" width="1000" height="180" as="geometry" />
        </mxCell>
        <mxCell id="cap2t" value="&lt;b&gt;SERVICE&lt;/b&gt;&amp;nbsp; — decide&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;readings/service.py&lt;/font&gt;" style="text;html=1;fontSize=16;fontColor=#ffffff;align=left;verticalAlign=top;" vertex="1" parent="c1">
          <mxGeometry x="80" y="315" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cap2c" value="Comprueba las reglas y lanza excepciones de DOMINIO: NotFoundError, no «404».&lt;br&gt;&lt;br&gt;Aquí NO se importa fastapi, no se devuelven códigos HTTP, no se conocen Request ni Response.&lt;br&gt;&lt;i&gt;Está escrito literalmente en service.py, líneas 5-8.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;← Esto es lo que escribes en la #24.&lt;/b&gt;" style="text;html=1;fontSize=13;fontColor=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="c1">
          <mxGeometry x="80" y="365" width="960" height="100" as="geometry" />
        </mxCell>

        <mxCell id="frontera" value="&lt;b&gt;LA FRONTERA — shared/protocols.py&lt;/b&gt;&amp;nbsp;&amp;nbsp; el service dice QUÉ métodos necesita, sin decir CÓMO se implementan" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffbe6;strokeColor=#f59e0b;strokeWidth=3;fontColor=#7a4a00;fontSize=13;" vertex="1" parent="c1">
          <mxGeometry x="60" y="510" width="1000" height="50" as="geometry" />
        </mxCell>

        <mxCell id="cap3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;strokeWidth=2;dashed=1;" vertex="1" parent="c1">
          <mxGeometry x="60" y="590" width="1000" height="160" as="geometry" />
        </mxCell>
        <mxCell id="cap3t" value="&lt;b&gt;REPOSITORY&lt;/b&gt;&amp;nbsp; — guarda y consulta&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;readings/repository.py — de Daruny, issue #14&lt;/font&gt;" style="text;html=1;fontSize=16;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="c1">
          <mxGeometry x="80" y="605" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cap3c" value="Hoy son 2 líneas: no existe. Por eso el service responde 501.&lt;br&gt;&lt;br&gt;&lt;b&gt;Tu salida:&lt;/b&gt; escribir un repository en memoria que cumpla el mismo Protocol. Cuando llegue el de Daruny, cambias una línea del proveedor y el service no se entera." style="text;html=1;fontSize=13;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="c1">
          <mxGeometry x="80" y="660" width="960" height="80" as="geometry" />
        </mxCell>

        <mxCell id="cnota" value="&lt;b&gt;Por qué importa esta separación&lt;/b&gt;&lt;br&gt;&lt;br&gt;1 · La misma regla la puede llamar el endpoint HTTP o, más adelante, el WebSocket. Sin duplicarla.&lt;br&gt;&lt;br&gt;2 · Se puede probar con pytest sin levantar FastAPI ni PostgreSQL.&lt;br&gt;&lt;br&gt;3 · Daruny no importa nada tuyo y tú no esperas a él." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fafb;strokeColor=#06b6d4;fontColor=#0c2340;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="c1">
          <mxGeometry x="1100" y="300" width="250" height="260" as="geometry" />
        </mxCell>

