        <mxCell id="titulo" value="Issue #24 — POST /api/readings" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#0c2340;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitulo" value="El camino que recorre una lectura desde el simulador hasta la respuesta. Cada rombo es una decisión que puede cortar el flujo." style="text;html=1;fontSize=13;fontColor=#0369a1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="900" height="24" as="geometry" />
        </mxCell>

        <mxCell id="sim" value="&lt;b&gt;Simulador&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;issue #16 · Daruny&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontColor=#333333;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="req" value="&lt;b&gt;POST /api/readings&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{ sensor_id, pressure, measured_at? }&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4f0f7;strokeColor=#0369a1;fontColor=#0c2340;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="310" y="135" width="330" height="70" as="geometry" />
        </mxCell>

