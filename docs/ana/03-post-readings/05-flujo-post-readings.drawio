  <diagram name="1 · Flujo de una lectura" id="flujo24">
    <mxGraphModel dx="1600" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
