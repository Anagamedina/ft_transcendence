ontSize=11;" vertex="1" parent="c40"><mxGeometry y="112" width="400" height="20" as="geometry"/></mxCell><mxCell id="c46" value="&amp;nbsp;&amp;nbsp;todos: JOIN sensors JOIN sites&lt;br&gt;&amp;nbsp;&amp;nbsp;WHERE sites.organization_id = :org" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c40"><mxGeometry y="132" width="400" height="34" as="geometry"/></mxCell><mxCell id="c47" value="«excepciones documentadas»&lt;br&gt;&lt;b&gt;Sin filtro de organización, a propósito&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="506" width="400" height="116" as="geometry"/></mxCell><mxCell id="c48" style="line;html=1;strokeWidth=1;" vertex="1" parent="c47"><mxGeometry y="44" width="400" height="8" as="geometry"/></mxCell><mxCell id="c49" value="SensorRepository.get(sensor_id)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c47"><mxGeometry y="52" width="400" height="20" as="geometry"/></mxCell><mxCell id="c50" value="AlertRepository.get_active(…) / escalate(…)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c47"><mxGeometry y="72" width="400" height="20" as="geometry"/></mxCell><mxCell id="c51" value="&amp;nbsp;&amp;nbsp;→ los usa el simulador, que no tiene sesión" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c47"><mxGeometry y="92" width="400" height="20" as="geometry"/></mxCell><mxCell id="c52" value="«core/exceptions.py»&lt;br&gt;&lt;b&gt;Respuestas&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1490" y="120" width="310" height="130" as="geometry"/></mxCell><mxCell id="c53" value="401 UNAUTHORIZED: sin sesión" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c52"><mxGeometry y="44" width="310" height="20" as="geometry"/></mxCell><mxCell id="c54" value="403 FORBIDDEN: rol insuficiente" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c52"><mxGeometry y="64" width="310" height="20" as="geometry"/></mxCell><mxCell id="c55" value="404 *_NOT_FOUND: de otra organización&lt;br&gt;&amp;nbsp;&amp;nbsp;(igual que si no existiera)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c52"><mxGeometry y="84" width="310" height="34" as="geometry"/></mxCell><mxCell id="c56" style="line;html=1;strokeWidth=1;" vertex="1" parent="c52"><mxGeometry y="118" width="310" height="8" as="geometry"/></mxCell><mxCell id="c57" value="«de dónde sale el tenant»&lt;br&gt;&lt;b&gt;Organization ← Site ← Sensor&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1490" y="280" width="310" height="116" as="geometry"/></mxCell><mxCell id="c58" value="organization 1 ── * sites" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c57"><mxGeometry y="44" width="310" height="20" as="geometry"/></mxCell><mxCell id="c59" value="site 1 ── * sensors" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c57"><mxGeometry y="64" width="310" height="20" as="geometry"/></mxCell><mxCell id="c60" value="sensor 1 ── * readings, alerts" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c57"><mxGeometry y="84" width="310" height="20" as="geometry"/></mxCell><mxCell id="c61" style="line;html=1;strokeWidth=1;" vertex="1" parent="c57"><mxGeometry y="104" width="310" height="8" as="geometry"/></mxCell><mxCell id="c62" value="Depends" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c3" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c63" value="devuelve" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c17" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c64" value="user.organization_id" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c3" target="c33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="132"/><mxPoint x="460" y="100"/><mxPoint x="960" y="100"/><mxPoint x="960" y="139"/></Array></mxGeometry></mxCell><mxCell id="c65" value="pasa organization_id" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c33" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c66" value="JOIN" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c40" target="c57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c68" value="&lt;b&gt;○ Lo que falta para cerrar la #27&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Matriz de permisos: qué rol puede qué, endpoint a endpoint.&lt;br&gt;2. Implementar &lt;b&gt;require_role&lt;/b&gt; (hoy 501) y usarla en register en vez de la comprobación a mano.&lt;br&gt;3. Aplicarla en los endpoints nuevos de la #25 y la #29.&lt;br&gt;4. Pruebas negativas por recurso: anónimo → 401, CLIENT en acción de ADMIN → 403, id de otra organización → 404.&lt;br&gt;5. Acordar con Frontend qué ve cada rol." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="380" height="250" as="geometry"/></mxCell><mxCell id="c69" value="&lt;b&gt;Regla de oro&lt;/b&gt;&lt;br&gt;La organización &lt;b&gt;sale de la sesión&lt;/b&gt;, nunca de la URL, la query o el body. Si viniera de fuera, bastaría con cambiar un número para leer datos de otro cliente.&lt;br&gt;&lt;br&gt;Y ocultar botones en el frontend no protege nada: la comprobación va en el backend." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1490" y="470" width="310" height="190" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="300" height="20" as="geometry"/></mxCell><mxCell id="c71" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="918" width="30" height="18" as="geometry"/></mxCell><mxCell id="c72" value="escrito o cambiado en esta issue (★ = nuevo)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="916" width="330" height="22" as="geometry"/></mxCell><mxCell id="c73" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="944" width="30" height="18" as="geometry"/></mxCell><mxCell id="c74" value="ya existía" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="942" width="330" height="22" as="geometry"/></mxCell><mxCell id="c75" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="30" height="18" as="geometry"/></mxCell><mxCell id="c76" value="contrato (Protocol)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="968" width="330" height="22" as="geometry"/></mxCell><mxCell id="c77" value="" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="996" width="30" height="18" as="geometry"/></mxCell><mxCell id="c78" value="modelo / tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="994" width="330" height="22" as="geometry"/></mxCell><mxCell id="c79" value="" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="1022" width="30" height="18" as="geometry"/></mxCell><mxCell id="c80" value="error de dominio" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1020" width="330" height="22" as="geometry"/></mxCell><mxCell id="c81" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1048" width="30" height="18" as="geometry"/></mxCell><mxCell id="c82" value="pendiente" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1046" width="330" height="22" as="geometry"/></mxCell><mxCell id="c83" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="1074" width="30" height="18" as="geometry"/></mxCell><mxCell id="c84" value="a medias" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1072" width="330" height="22" as="geometry"/></mxCell><mxCell id="c85" value="&lt;font style='font-size:11px'&gt;- - -▷ &amp;nbsp;cumple el contrato (realización)&lt;br&gt;- - -&amp;gt; &amp;nbsp;depende de / usa&lt;br&gt;——&amp;gt; &amp;nbsp;tiene una referencia (asociación)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1104" width="380" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2___Secuencia" name="2 · Secuencia"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L0" value="Navegador" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="160" height="860" as="geometry"/></mxCell><mxCell id="L1" value="get_current_user" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="160" height="860" as="geometry"/></mxCell><mxCell id="L2" value="router" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="160" height="860" as="geometry"/></mxCell><mxCell id="L3" value="AlertService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="750" y="110" width="160" height="860" as="geometry"/></mxCell><mxCell id="L4" value="AlertRepository" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="980" y="110" width="160" height="860" as="geometry"/></mxCell><mxCell id="L5" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1210" y="110" width="160" height="860" as="geometry"/></mxCell><mxCell id="c2" value="&lt;font style='font-size:20px'&gt;&lt;b&gt;Issue #27 · cómo se protege hoy una ruta privada — diagrama de secuencia&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Tres intentos que el backend rechaza, cada uno en una capa distinta." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="-80" height="70" as="geometry"/></mxCell><mxCell id="c3" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="214" as="sourcePoint"/><mxPoint x="1390.0" y="214" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" value="&lt;b&gt;A · Sin sesión → 401  (lo para la dependency)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1a4d8f;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="900" height="22" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;1. PATCH /api/alerts/{id}/resolve  (sin cookie)&lt;/b&gt;" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140.0" y="266" as="sourcePoint"/><mxPoint x="600.0" y="266" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="Depends(get_current_user)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600.0" y="298" as="sourcePoint"/><mxPoint x="370.0" y="298" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;401 UNAUTHORIZED: el endpoint ni se ejecuta&lt;/b&gt;" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370.0" y="330" as="sourcePoint"/><mxPoint x="140.0" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="360" as="sourcePoint"/><mxPoint x="1390.0" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;B · Alerta de otra organización → 404  (lo para el SQL)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1a4d8f;" vertex="1" parent="1"><mxGeometry x="40" y="362" width="900" height="22" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;2. PATCH /api/alerts/{id_de_la_org_A}/resolve&lt;br&gt;cookie de un usuario de la organización B&lt;/b&gt;" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140.0" y="426" as="sourcePoint"/><mxPoint x="600.0" y="426" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="Depends(get_current_user)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600.0" y="458" as="sourcePoint"/><mxPoint x="370.0" y="458" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="SELECT user WHERE id = :id" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370.0" y="490" as="sourcePoint"/><mxPoint x="1290.0" y="490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="User(organization_id = B)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370.0" y="522" as="sourcePoint"/><mxPoint x="600.0" y="522" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="3. resolve(alert_id, organization_id = B)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600.0" y="554" as="sourcePoint"/><mxPoint x="830.0" y="554" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="4. _propia_o_404 → get_by_id(alert_id, B)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830.0" y="586" as="sourcePoint"/><mxPoint x="1060.0" y="586" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="SELECT alert JOIN sensor JOIN site&lt;br&gt;WHERE alert.id = :id AND site.organization_id = B" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060.0" y="632" as="sourcePoint"/><mxPoint x="1290.0" y="632" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="None  (la alerta es de A)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060.0" y="664" as="sourcePoint"/><mxPoint x="830.0" y="664" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;404 ALERT_NOT_FOUND: igual que si no existiera&lt;/b&gt;" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830.0" y="696" as="sourcePoint"/><mxPoint x="140.0" y="696" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="726" as="sourcePoint"/><mxPoint x="1390.0" y="726" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;C · Rol insuficiente → 403  (lo para el router, a mano)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1a4d8f;" vertex="1" parent="1"><mxGeometry x="40" y="728" width="900" height="22" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;5. POST /api/auth/register  (cookie de un CLIENT)&lt;/b&gt;" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140.0" y="778" as="sourcePoint"/><mxPoint x="600.0" y="778" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="Depends(get_current_user)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600.0" y="810" as="sourcePoint"/><mxPoint x="370.0" y="810" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="User(role = client)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370.0" y="842" as="sourcePoint"/><mxPoint x="600.0" y="842" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;403 FORBIDDEN «Solo un administrador puede dar de alta cuentas.»&lt;/b&gt;" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600.0" y="904" as="sourcePoint"/><mxPoint x="140.0" y="904" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=46;height=20;fontSize=11;fontStyle=1;fillColor=none;fillColor=#f8cecc;strokeColor=#b85450;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60.0" y="858" width="620.0" height="66" as="geometry"/></mxCell><mxCell id="c26" value="&lt;i&gt;[user.role != &amp;quot;admin&amp;quot;]&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="112.0" y="859" width="560.0" height="20" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;¿Por qué 404 y no 403 en el caso B?&lt;/b&gt;&lt;br&gt;Decir «existe pero no es tuya» ya confirma que ese id es real. Respondiendo lo mismo que a un id inventado, no se filtra nada." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1420.0" y="200" width="340" height="150" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;○ Lo que cambiará con la #27&lt;/b&gt;&lt;br&gt;El caso C debería resolverse con &lt;b&gt;Depends(require_role(&amp;quot;admin&amp;quot;))&lt;/b&gt;, igual que A con get_current_user: una línea en la firma, sin if dentro del endpoint. Hoy require_role responde 501." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1420.0" y="380" width="340" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3___Flujo_global" name="3 · Flujo global"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style='font-size:22px'&gt;&lt;b&gt;AquaGuard · dónde encaja la #27&lt;/b&gt;&lt;/font&gt;&lt;br&gt;El recorrido de una lectura, desde el simulador hasta el dashboard. Lo que toca la #27 va con &lt;b&gt;borde negro grueso&lt;/b&gt;." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1770" height="70" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;1 · De dónde sale el dato&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Simulador&lt;/b&gt; &amp;nbsp;&lt;i&gt;simulator/&lt;/i&gt;&lt;br&gt;○ pendiente · #16 / #89 (Eduardo)&lt;br&gt;&lt;br&gt;Hace de sensor: cada N segundos envía una lectura. Hoy &lt;b&gt;main.py solo es un esqueleto&lt;/b&gt;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="250" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Hoy la alimentan&lt;/b&gt;&lt;br&gt;✔ tests pytest (TestClient)&lt;br&gt;✔ Swagger /docs o curl" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="250" height="90" as="geometry"/></mxCell><mxCell id="c6" value="2 · Backend FastAPI  (backend:8000)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="850" height="620" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ENTRADA · escribe&lt;/b&gt; (sin login)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#2d7600;" vertex="1" parent="1"><mxGeometry x="350" y="160" width="300" height="24" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;SALIDA · lee&lt;/b&gt; (siempre con sesión)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#1a4d8f;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="330" height="24" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;POST /api/readings&lt;/b&gt; &amp;nbsp;✔ #24&lt;br&gt;Valida el JSON con ReadingCreate&lt;br&gt;→ 422 si no encaja" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="350" y="200" width="300" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;ReadingService.create()&lt;/b&gt; &amp;nbsp;✔ #24&lt;br&gt;• ¿existe el sensor? si no → 404&lt;br&gt;• pressure → value, unit del sensor&lt;br&gt;• guarda dentro de transaction() → COMMIT" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="350" y="300" width="300" height="95" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Reglas LOW / HIGH_PRESSURE&lt;/b&gt; &amp;nbsp;◐ #28&lt;br&gt;En la misma transacción: abre o empeora la alerta. &lt;i&gt;PR #98 abierta.&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="425" width="300" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Regla SENSOR_OFFLINE&lt;/b&gt; &amp;nbsp;○ #28&lt;br&gt;Necesita &lt;i&gt;last_seen_at&lt;/i&gt;, que aún no existe (#97, Daruny)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="350" y="525" width="300" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Auth&lt;/b&gt; &amp;nbsp;✔ #26 · register, login, logout, /api/me&lt;br&gt;&lt;b&gt;Permisos y organización&lt;/b&gt; &amp;nbsp;◐ #27&lt;br&gt;(filtro por organización ya aplicado; roles no)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=4;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="800" y="200" width="330" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;GET /api/sensors/{id}/readings&lt;/b&gt; &amp;nbsp;✔ #25&lt;br&gt;Histórico paginado de un sensor" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=4;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="330" height="55" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;GET /api/alerts&lt;/b&gt; · PATCH acknowledge / resolve&lt;br&gt;✔ #28 (PR #78)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=4;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="800" y="375" width="330" height="60" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;GET /api/sensors&lt;/b&gt; · &lt;b&gt;GET /api/sensors/{id}&lt;/b&gt;&lt;br&gt;○ #25 · el router existe sin rutas" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="800" y="455" width="330" height="55" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Sites&lt;/b&gt; y &lt;b&gt;POST / PATCH sensors&lt;/b&gt;&lt;br&gt;○ #29" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="800" y="530" width="330" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;font style='font-size:11px'&gt;Cada petición cruza tres capas: &lt;b&gt;router&lt;/b&gt; (solo HTTP) → &lt;b&gt;service&lt;/b&gt; (reglas, no sabe qué es un 404) → &lt;b&gt;repository&lt;/b&gt; (solo SQL, de Daruny).&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="350" y="640" width="780" height="60" as="geometry"/></mxCell><mxCell id="c19" value="3 · PostgreSQL  (tablas de Daruny, #13 y #18)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="770" width="850" height="170" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;sensors&lt;/b&gt; · &lt;b&gt;sites&lt;/b&gt; · &lt;b&gt;users&lt;/b&gt;&lt;br&gt;unit, low/high_threshold, site_id → organization_id&lt;br&gt;&lt;i&gt;○ falta last_seen_at (#97)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="350" y="820" width="220" height="95" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;readings&lt;/b&gt;&lt;br&gt;sensor_id, value, unit, recorded_at, created_at" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="610" y="820" width="220" height="95" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;alerts&lt;/b&gt;&lt;br&gt;status ACTIVE → RESOLVED&lt;br&gt;severity WARNING / CRITICAL&lt;br&gt;acknowledged_at, resolved_at" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="880" y="820" width="250" height="95" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;4 · Quién lo enseña&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1230" y="110" width="560" height="30" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Gateway Nginx&lt;/b&gt; &amp;nbsp;✔ #20&lt;br&gt;HTTPS :443&lt;br&gt;/api/ → backend:8000&lt;br&gt;/ws/ → reservado" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1230" y="200" width="220" height="95" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Frontend Vue&lt;/b&gt;&lt;br&gt;• Dashboard Admin ◐ #7 (Florinda)&lt;br&gt;• Dashboard Cliente ○ #39 (Lylia)&lt;br&gt;• Históricos ○ #40 (Lylia)&lt;br&gt;• Sensores y alertas Admin ○ #38&lt;br&gt;• Mapa de sites ○ #8&lt;br&gt;&lt;br&gt;&lt;i&gt;Hoy tira casi todo de mockAdapter (VITE_USE_MOCK): datos falsos con la misma forma que la API.&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1510" y="185" width="290" height="190" as="geometry"/></mxCell><mxCell id="c26" value="① POST /api/readings&lt;br&gt;directo a backend:8000&lt;br&gt;(red interna, sin Nginx ni login)" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="405"/><mxPoint x="320" y="256"/></Array></mxGeometry></mxCell><mxCell id="c28" value="②" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="③ SELECT sensor" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c10" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="335" y="347"/><mxPoint x="335" y="795"/><mxPoint x="460" y="795"/></Array></mxGeometry></mxCell><mxCell id="c30" value="④ INSERT + COMMIT" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7600;endArrow=block;endFill=1;" edge="1" parent="1" source="c10" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="347"/></Array></mxGeometry></mxCell><mxCell id="c31" value="⑤ (#28)" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;dashed=1;strokeColor=#d79b00;endArrow=block;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="abre / empeora alerta" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.32;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#d79b00;endArrow=block;endFill=1;" edge="1" parent="1" source="c11" target="c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="745" y="460"/><mxPoint x="745" y="760"/><mxPoint x="960" y="760"/></Array></mxGeometry></mxCell><mxCell id="c33" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=0.73;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1a4d8f;endArrow=block;endFill=1;" edge="1" parent="1" source="c21" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="780"/><mxPoint x="1145" y="780"/><mxPoint x="1145" y="327"/></Array></mxGeometry></mxCell><mxCell id="c34" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=0.64;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1a4d8f;endArrow=block;endFill=1;" edge="1" parent="1" source="c22" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="800"/><mxPoint x="1160" y="800"/><mxPoint x="1160" y="405"/></Array></mxGeometry></mxCell><mxCell id="c35" value="⑥ HTTPS + cookie de sesión" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c25" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="⑦ /api/…" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=default;strokeWidth=2;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c24" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;El recorrido de un dato, en frase&lt;/b&gt;&lt;br&gt;&lt;br&gt;① El simulador mide y envía la lectura.&lt;br&gt;② El router valida el JSON y se la pasa al service.&lt;br&gt;③ El service comprueba que el sensor existe.&lt;br&gt;④ La guarda en &lt;i&gt;readings&lt;/i&gt; y la confirma (COMMIT) → &lt;b&gt;201&lt;/b&gt;.&lt;br&gt;⑤ Si la presión sale de los umbrales, abre una alerta (#28).&lt;br&gt;⑥ El usuario abre el dashboard, que llama por HTTPS.&lt;br&gt;⑦ Con sesión (#26) y solo de su organización (#27), lee histórico (#25) y alertas (#28).&lt;br&gt;&lt;br&gt;Lo de la izquierda escribe, lo de la derecha lee: &lt;b&gt;todo lo que se ve en el producto sale de lo que entra por ①–④ (#24).&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=10;strokeColor=#999999;fillColor=#fafafa;rounded=1;" vertex="1" parent="1"><mxGeometry x="1230" y="440" width="570" height="290" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="770" width="300" height="22" as="geometry"/></mxCell><mxCell id="c39" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1230" y="798" width="30" height="18" as="geometry"/></mxCell><mxCell id="c40" value="✔ hecho (en develop)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="796" width="300" height="22" as="geometry"/></mxCell><mxCell id="c41" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1230" y="824" width="30" height="18" as="geometry"/></mxCell><mxCell id="c42" value="◐ en curso / a medias" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="822" width="300" height="22" as="geometry"/></mxCell><mxCell id="c43" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1230" y="850" width="30" height="18" as="geometry"/></mxCell><mxCell id="c44" value="○ pendiente" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="848" width="300" height="22" as="geometry"/></mxCell><mxCell id="c45" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1230" y="876" width="30" height="18" as="geometry"/></mxCell><mxCell id="c46" value="infraestructura y frontend" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="874" width="300" height="22" as="geometry"/></mxCell><mxCell id="c47" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1230" y="902" width="30" height="18" as="geometry"/></mxCell><mxCell id="c48" value="base de datos" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="900" width="300" height="22" as="geometry"/></mxCell><mxCell id="c49" value="&lt;font style='font-size:11px'&gt;&lt;b&gt;Borde negro grueso = lo de la #27.&lt;/b&gt;&lt;br&gt;Flecha verde = escribe · azul = lee · naranja discontinua = #28, aún en PR.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1510" y="798" width="290" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
