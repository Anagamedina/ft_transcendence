eft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c11"><mxGeometry y="92" width="380" height="20" as="geometry"/></mxCell><mxCell id="c16" value="GET /api/health · /api/health/db" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c11"><mxGeometry y="112" width="380" height="20" as="geometry"/></mxCell><mxCell id="c17" value="«dependency · #26»&lt;br&gt;&lt;b&gt;get_current_user(request, db) → User&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="510" y="120" width="400" height="96" as="geometry"/></mxCell><mxCell id="c18" style="line;html=1;strokeWidth=1;" vertex="1" parent="c17"><mxGeometry y="44" width="400" height="8" as="geometry"/></mxCell><mxCell id="c19" value="cookie → user_id → SELECT user" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c17"><mxGeometry y="52" width="400" height="20" as="geometry"/></mxCell><mxCell id="c20" value="sin sesión válida → 401" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c17"><mxGeometry y="72" width="400" height="20" as="geometry"/></mxCell><mxCell id="c21" value="«lo que sale de la sesión»&lt;br&gt;&lt;b&gt;User&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="510" y="246" width="400" height="96" as="geometry"/></mxCell><mxCell id="c22" value="+ role: &amp;quot;admin&amp;quot; | &amp;quot;client&amp;quot;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c21"><mxGeometry y="44" width="400" height="20" as="geometry"/></mxCell><mxCell id="c23" value="+ organization_id: UUID | None" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c21"><mxGeometry y="64" width="400" height="20" as="geometry"/></mxCell><mxCell id="c24" style="line;html=1;strokeWidth=1;" vertex="1" parent="c21"><mxGeometry y="84" width="400" height="8" as="geometry"/></mxCell><mxCell id="c25" value="«dependency · shared/dependencies.py»&lt;br&gt;&lt;b&gt;require_role(*roles)&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="510" y="372" width="400" height="96" as="geometry"/></mxCell><mxCell id="c26" style="line;html=1;strokeWidth=1;" vertex="1" parent="c25"><mxGeometry y="44" width="400" height="8" as="geometry"/></mxCell><mxCell id="c27" value="○ hoy lanza 501 NOT_IMPLEMENTED (#27)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c25"><mxGeometry y="52" width="400" height="20" as="geometry"/></mxCell><mxCell id="c28" value="ninguna ruta la usa todavía" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontSize=11;" vertex="1" parent="c25"><mxGeometry y="72" width="400" height="20" as="geometry"/></mxCell><mxCell id="c29" value="«comprobación de rol a mano»&lt;br&gt;&lt;b&gt;auth/router.py · register()&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="510" y="498" width="400" height="96" as="geometry"/></mxCell><mxCell id="c30" style="line;html=1;strokeWidth=1;" vertex="1" parent="c29"><mxGeometr