<mxfile host="app.diagrams.net"><diagram id="p0" name="0 · Índice"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;font style="font-size:22px"&gt;&lt;b&gt;AquaGuard · el backend por dentro&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#555555"&gt;Cómo funciona FastAPI por debajo y por qué existe la tarea de fondo que detecta sensores sin señal. Hecho a partir del código de develop (PR #181).&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="70" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Pestañas&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1 · Capas&lt;/b&gt;: Uvicorn, ASGI, Starlette, FastAPI. API ≠ servidor.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 · Event loop y pool de hilos&lt;/b&gt;: qué es bloquear y quién hace cada cosa.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 · Una petición por dentro&lt;/b&gt;: GET /api/alerts paso a paso y el truco del yield.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 · Arranque y apagado (lifespan)&lt;/b&gt;: dónde nace y muere la tarea de fondo.&lt;br&gt;&lt;br&gt;&lt;b&gt;5 · Tarea de fondo: por qué&lt;/b&gt;: el problema del sensor mudo y la decisión.&lt;br&gt;&lt;br&gt;&lt;b&gt;6 · Tarea de fondo: cómo por dentro&lt;/b&gt;: vigilar(), una_vuelta(), detectar_sensores_mudos()." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="640" height="400" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Leyenda de colores&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="120" width="600" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Servidor (Uvicorn)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="720" y="160" width="280" height="50" as="geometry"/></mxCell><mxCell id="c5" value="Event loop: hilo principal" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="220" width="280" height="50" as="geometry"/></mxCell><mxCell id="c6" value="Pool de hilos: ayudantes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="720" y="280" width="280" height="50" as="geometry"/></mxCell><mxCell id="c7" value="Nota / explicación" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720" y="340" width="280" height="50" as="geometry"/></mxCell><mxCell id="c8" value="Problema / lo que no funciona" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="720" y="400" width="280" height="50" as="geometry"/></mxCell><mxCell id="c9" value="PostgreSQL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="470" width="140" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;La cafetería&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Camarero&lt;/b&gt; = event loop (1 hilo)&lt;br&gt;&lt;b&gt;Ayudantes&lt;/b&gt; = pool de hilos (~40)&lt;br&gt;&lt;b&gt;Cafetera que no avisa&lt;/b&gt; = SQLAlchemy síncrono&lt;br&gt;&lt;b&gt;Quedarse mirando la cafetera&lt;/b&gt; = bloquear&lt;br&gt;&lt;b&gt;«Pon el café y vete a otra mesa»&lt;/b&gt; = await&lt;br&gt;&lt;b&gt;La carta&lt;/b&gt; = la API&lt;br&gt;&lt;b&gt;Enchufe estándar&lt;/b&gt; = ASGI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1020" y="160" width="330" height="290" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="1 · Capas"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;font style="font-size:22px"&gt;&lt;b&gt;1 · Quién ejecuta el backend: tres capas&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#555555"&gt;Quien se ejecuta no es FastAPI, es Uvicorn. FastAPI es una librería que Uvicorn llama a través de ASGI.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="70" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Frontend Vue&lt;/b&gt; (lee y gestiona) · &lt;b&gt;Simulador&lt;/b&gt; (manda lecturas)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="110" width="380" height="60" as="geometry"/></mxCell><mxCell id="c3" value="Contenedor Docker del backend" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fontSize=14;fontStyle=1;rounded=1;arcSize=2;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="680" height="760" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;UVICORN&lt;/b&gt; · el servidor&lt;br&gt;abre el puerto 8000 · tiene el event loop de asyncio&lt;br&gt;convierte bytes de la red ↔ diccionario Python" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="100" y="290" width="560" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;STARLETTE&lt;/b&gt; · framework web base&lt;br&gt;rutas, cookies, evento lifespan, ejecutar funciones def en hilos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="470" width="560" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;FASTAPI&lt;/b&gt; · encima de Starlette&lt;br&gt;Depends, validación con Pydantic (422), Swagger en /api/docs, JSON" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="630" width="560" height="90" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Nuestro código&lt;/b&gt;&lt;br&gt;router.py → service.py → repository.py → model.py&lt;br&gt;&lt;font color="#555555"&gt;Ana: router, service, schemas · Daruny: model, repositories, migraciones&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="100" y="800" width="560" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;otro contenedor" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="820" y="820" width="170" height="100" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="HTTP · bytes por la red · puerto 8000" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="180" width="330" height="40" as="geometry"/></mxCell><mxCell id="c11" value="ASGI: un diccionario (scope) + recibir / enviar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value='Arranque real (&lt;code&gt;backend/tools/entrypoint.sh&lt;/code&gt;):&lt;br&gt;&lt;font face="Courier New"&gt;&lt;b&gt;exec uvicorn app.main:app --host 0.0.0.0 --port 8000&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Un solo proceso, sin --workers.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;fontFamily=Courier New;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="620" height="120" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;Qué es ASGI&lt;/b&gt;&lt;br&gt;El contrato entre servidor y app, como un enchufe estándar. Uvicorn sabe de redes; FastAPI, de sensores. ASGI fija cómo se pasan la petición y la respuesta, y los avisos de arranque y apagado (lifespan.startup / shutdown).&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;{"type": "http", "method": "GET",&lt;br&gt;&amp;nbsp;"path": "/api/alerts",&lt;br&gt;&amp;nbsp;"headers": [(b"cookie", b"aquaguard_session=...")]}&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="820" y="260" width="620" height="230" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;API ≠ servidor&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;API&lt;/b&gt; = la carta: qué se puede pedir y cómo. Rutas /api/..., datos de entrada, JSON de salida, formato de error, cookie, X-Ingest-Key. Escrita en OpenAPI.&lt;br&gt;&lt;br&gt;&lt;b&gt;Servidor&lt;/b&gt; = el camarero: Uvicorn, que escucha y entrega.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cocina&lt;/b&gt; = FastAPI + nuestro código, que implementa la API.&lt;br&gt;&lt;br&gt;Prueba: el &lt;b&gt;MockAdapter&lt;/b&gt; del frontend implementa la misma API sin ningún servidor." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="820" y="520" width="620" height="270" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2 · Event loop y pool de hilos"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;font style="font-size:22px"&gt;&lt;b&gt;2 · Un camarero y sus ayudantes: event loop y pool de hilos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#555555"&gt;Todo vive dentro de un único proceso uvicorn. El event loop nunca debe quedarse esperando: lo que bloquea se lo pasa a un hilo del pool.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="70" as="geometry"/></mxCell><mxCell id="c2" value="Proceso uvicorn (uno solo)" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fontSize=14;fontStyle=1;rounded=1;arcSize=2;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1060" height="620" as="geometry"/></mxCell><mxCell id="c3" value="Hilo principal: EVENT LOOP (asyncio)" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fontSize=14;fontStyle=1;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="460" height="540" as="geometry"/></mxCell><mxCell id="c4" value="Escucha el puerto 8000" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="100" y="220" width="400" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Coordina cada petición:&lt;br&gt;leer bytes, buscar la ruta, Depends, validar, convertir a JSON" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="100" y="300" width="400" height="80" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Tarea vigilar()&lt;/b&gt;&lt;br&gt;casi siempre dormida en &lt;font face="Courier New"&gt;await asyncio.sleep(60)&lt;/font&gt;&lt;br&gt;dormida no ocupa ningún hilo' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="100" y="400" width="400" height="90" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Salta de tarea en tarea&lt;/b&gt;&lt;br&gt;Solo cambia de tarea en un &lt;font face="Courier New"&gt;await&lt;/font&gt;: «espero esto; mientras, atiende a otro».&lt;br&gt;Un solo hilo atiende a cientos de clientes porque casi siempre están esperando.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="100" y="510" width="400" height="160" as="geometry"/></mxCell><mxCell id="c8" value="Pool de hilos (AnyIO, ~40 hilos)" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fontSize=14;fontStyle=1;rounded=1;arcSize=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="600" y="160" width="470" height="540" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Hilo:&lt;/b&gt; list_alerts&lt;br&gt;(endpoint escrito con def)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="630" y="220" width="410" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Hilo:&lt;/b&gt; create_reading&lt;br&gt;(POST /api/readings del simulador)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="630" y="310" width="410" height="70" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Hilo:&lt;/b&gt; una_vuelta() del vigilante&lt;br&gt;(enviada con &lt;font face="Courier New"&gt;asyncio.to_thread&lt;/font&gt;)' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="630" y="400" width="410" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;¿Por qué un grupo fijo?&lt;/b&gt;&lt;br&gt;Crear un hilo cuesta tiempo y memoria. Se crean de antemano y se reutilizan: cuando uno termina, vuelve a la piscina libre para el siguiente encargo." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="630" y="510" width="410" height="160" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1200" y="330" width="170" height="110" as="geometry"/></mxCell><mxCell id="c14" value="trabajo bloqueante" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.333;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="SQL síncrono" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Bloquear&lt;/b&gt; = quedarse parado esperando sin poder hacer nada más.&lt;br&gt;&lt;br&gt;SQLAlchemy tal como lo usamos es una «cafetera que no avisa»: el hilo que consulta se queda quieto hasta que PostgreSQL contesta." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1150" y="110" width="410" height="190" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;¿Dónde ejecuta FastAPI cada endpoint?&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c18" value='&lt;font face="Courier New"&gt;&lt;b&gt;async def&lt;/b&gt;&lt;/font&gt; → directamente en el event loop.&lt;br&gt;&lt;br&gt;Si dentro hay algo bloqueante (una consulta síncrona), &lt;b&gt;congela todo el backend&lt;/b&gt;.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="500" height="130" as="geometry"/></mxCell><mxCell id="c19" value='&lt;font face="Courier New"&gt;&lt;b&gt;def&lt;/b&gt;&lt;/font&gt; → al pool de hilos. &lt;b&gt;Nuestro caso.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Es lo correcto porque SQLAlchemy es síncrono: el loop sigue libre. Ej.: &lt;font face="Courier New"&gt;def list_alerts&lt;/font&gt; (alerts/router.py:83).' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="570" y="800" width="500" height="130" as="geometry"/></mxCell><mxCell id="c20" value='Dos formas de llegar al pool:&lt;br&gt;· FastAPI, sola: endpoints &lt;font face="Courier New"&gt;def&lt;/font&gt;&lt;br&gt;· Nosotros, a mano: &lt;font face="Courier New"&gt;await asyncio.to_thread(una_vuelta)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1100" y="800" width="460" height="130" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;En una frase:&lt;/b&gt; el event loop es el camarero que salta de mesa en mesa; el pool son los ayudantes que esperan delante de las cafeteras que no avisan. El camarero nunca se queda mirando una cafetera." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="1520" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3 · Una petición por dentro"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;font style="font-size:22px"&gt;&lt;b&gt;3 · GET /api/alerts paso a paso&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#555555"&gt;Azul: corre en el event loop. Verde: corre en un hilo del pool. Morado: Uvicorn.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="70" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;1&lt;/b&gt; · Uvicorn lee los bytes de la red y los convierte en un diccionario ASGI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="620" height="80" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;2&lt;/b&gt; · Starlette busca la ruta: /api/alerts → list_alerts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="215" width="620" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;3&lt;/b&gt; · FastAPI resuelve los Depends: get_db (abre la sesión y se pausa en su yield), get_current_user (cookie), get_org_scope, paginación" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="620" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;4&lt;/b&gt; · Pydantic valida los parámetros (422 si fallan)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="425" width="620" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;5&lt;/b&gt; · list_alerts es def → a un hilo del pool: router → AlertService → AlertRepository → PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="620" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;6&lt;/b&gt; · El resultado pasa por el schema de respuesta → JSON" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="635" width="620" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;7&lt;/b&gt; · get_db continúa después de su yield → db.close()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="620" height="80" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;8&lt;/b&gt; · Uvicorn envía los bytes de vuelta al navegador" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="845" width="620" height="80" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="760" y="520" width="160" height="100" as="geometry"/></mxCell><mxCell id="c18" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;El truco del yield&lt;/b&gt; (core/database.py:77)&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;def get_db():&lt;br&gt;&amp;nbsp;&amp;nbsp;db = SessionLocal()&lt;br&gt;&amp;nbsp;&amp;nbsp;try:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;yield db&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# aquí corre el endpoint&lt;br&gt;&amp;nbsp;&amp;nbsp;finally:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;db.close()&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# siempre, aunque falle&lt;/font&gt;&lt;br&gt;&lt;br&gt;yield &lt;b&gt;pausa la función a la mitad&lt;/b&gt; y la retoma después: preparar → usar → recoger.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="980" y="110" width="580" height="300" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;La misma idea a dos escalas&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;get_db&lt;/b&gt;: abre la sesión → &lt;i&gt;una petición&lt;/i&gt; → cierra la sesión&lt;br&gt;&lt;br&gt;&lt;b&gt;lifespan&lt;/b&gt;: lanza el vigilante → &lt;i&gt;la app entera vive&lt;/i&gt; → para el vigilante" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="980" y="440" width="580" height="200" as="geometry"/></mxCell><mxCell id="c21" value='Por eso el vigilante abre su propia sesión con &lt;font face="Courier New"&gt;SessionLocal()&lt;/font&gt;: no corre dentro de ninguna petición, así que no hay get_db que se la dé.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="980" y="670" width="580" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4 · Arranque y apagado (lifespan)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;font style="font-size:22px"&gt;&lt;b&gt;4 · El lifespan: dónde nace y muere la tarea de fondo&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#555555"&gt;El lifespan no es la tarea de fondo: es el gancho de arranque y apagado. Es un evento del protocolo ASGI que Uvicorn envía a la app.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="70" as="geometry"/></mxCell><mxCell id="c2" value="docker compose up" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="240" height="100" as="geometry"/></mxCell><mxCell id="c3" value="uvicorn importa app.main → create_app() → existe el objeto app" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="310" y="120" width="240" height="100" as="geometry"/></mxCell><mxCell id="c4" value="uvicorn crea el event loop" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="580" y="120" width="240" height="100" as="geometry"/></mxCell><mxCell id="c5" value="evento ASGI &lt;b&gt;lifespan.startup&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="850" y="120" width="240" height="100" as="geometry"/></mxCell><mxCell id="c6" value='código ANTES del yield:&lt;br&gt;&lt;font face="Courier New"&gt;asyncio.create_task(vigilar())&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1120" y="120" width="240" height="100" as="geometry"/></mxCell><mxCell id="c7" value="startup.complete → &lt;b&gt;solo ahora&lt;/b&gt; se abre el puerto 8000" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1390" y="120" width="240" height="100" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;LA APP VIVE&lt;/b&gt; · el lifespan está pausado en el &lt;font face="Courier New"&gt;yield&lt;/font&gt; durante horas o días · el loop atiende peticiones · el vigilante hace su ronda cada minuto' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="1590" height="90" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="c7" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="docker stop / Ctrl+C" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="240" height="110" as="geometry"/></mxCell><mxCell id="c16" value="uvicorn deja de aceptar peticiones" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="310" y="410" width="240" height="110" as="geometry"/></mxCell><mxCell id="c17" value="evento ASGI &lt;b&gt;lifespan.shutdown&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="580" y="410" width="240" height="110" as="geometry"/></mxCell><mxCell id="c18" value='código DESPUÉS del yield (finally):&lt;br&gt;&lt;font face="Courier New"&gt;tarea.cancel()&lt;br&gt;await tarea&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="850" y="410" width="240" height="110" as="geometry"/></mxCell><mxCell id="c19" value="shutdown.complete → el proceso termina" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1120" y="410" width="240" height="110" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b&gt;backend/app/main.py:143&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;@asynccontextmanager&lt;br&gt;async def lifespan(_app: FastAPI):&lt;br&gt;&amp;nbsp;&amp;nbsp;tarea = asyncio.create_task(vigilar())&amp;nbsp;&amp;nbsp;# 1 al arrancar&lt;br&gt;&amp;nbsp;&amp;nbsp;try:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;yield&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; # 2 la app vive&lt;br&gt;&amp;nbsp;&amp;nbsp;finally:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;tarea.cancel()&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# 3 al apagar&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;with suppress(asyncio.CancelledError):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;await tarea&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; #&amp;nbsp;&amp;nbsp; termina limpio&lt;br&gt;&lt;br&gt;app = FastAPI(lifespan=lifespan, ...)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;fontFamily=Courier New;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="760" height="330" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;¿Por qué cancelar al apagar?&lt;/b&gt;&lt;br&gt;vigilar() es un bucle infinito. Sin cancelarlo, el apagado podría quedarse colgado o cortarlo a medias. Al cancelar, Python lanza CancelledError dentro de la tarea; es lo esperado y suppress lo ignora para que no salga como fallo." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="840" y="570" width="790" height="150" as="geometry"/></mxCell><mxCell id="c27" value='&lt;b&gt;¿Y en los tests?&lt;/b&gt;&lt;br&gt;TestClient(app) solo ejecuta el lifespan si se usa con &lt;font face="Courier New"&gt;with&lt;/font&gt;. Los tests no lo hacen, así que el vigilante no arranca y no aparecen alertas por su cuenta. La lógica se prueba aparte: detectar_sensores_mudos acepta un «ahora» falso.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="840" y="740" width="790" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5 · Tarea de fondo: por qué"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;font style="font-size:22px"&gt;&lt;b&gt;5 · Por qué hace falta una tarea de fondo&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#555555"&gt;Casi todo el backend es reactivo: espera una petición y actúa. Un sensor desconectado no manda nada, así que nada lo dispara.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="70" as="geometry"/></mxCell><mxCell id="c2" value="Llega una lectura&lt;br&gt;POST /api/readings" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="220" height="70" as="geometry"/></mxCell><mxCell id="c3" value="rules.py compara con los umbrales" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="130" width="220" height="70" as="geometry"/></mxCell><mxCell id="c4" value="Abre o empeora&lt;br&gt;LOW / HIGH_PRESSURE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="130" width="220" height="70" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Presión: funciona.&lt;/b&gt; Cada lectura dispara la regla." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="140" width="380" height="60" as="geometry"/></mxCell><mxCell id="c8" value="El sensor se desconecta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="220" height="70" as="geometry"/></mxCell><mxCell id="c9" value="No llega ninguna petición" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="340" y="250" width="220" height="70" as="geometry"/></mxCell><mxCell id="c10" value="Nada se ejecuta:&lt;br&gt;nadie se entera" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="620" y="250" width="220" height="70" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Sensor mudo: no funciona&lt;/b&gt; con un backend solo reactivo. Hace falta algo que mire por iniciativa propia." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="260" width="420" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Las dos opciones que se compararon&lt;/b&gt; (decisión de Ana, 04-10-2026, alerts/vigilante.py)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;A · Calcularlo al consultar las alertas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cuando alguien hace GET /api/alerts, mirar qué sensores llevan más de 5 min callados.&lt;br&gt;&lt;br&gt;✗ La alerta solo «existe» si alguien está mirando la app.&lt;br&gt;✗ No queda la hora real en que se detectó." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="700" height="170" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;B · Tarea periódica en segundo plano · ELEGIDA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Un «vigilante» que arranca con la app y cada minuto busca sensores mudos.&lt;br&gt;&lt;br&gt;✓ La alerta aparece a tiempo aunque nadie esté mirando.&lt;br&gt;✓ Lleva la fecha real de cuando se detectó.&lt;br&gt;✓ Se guarda una sola vez, como cualquier otra alerta: el frontend la lista igual." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="820" y="410" width="720" height="170" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Las reglas que comparte con el resto del backend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;5 minutos&lt;/b&gt; (OFFLINE_TRAS, sensors/status.py)&lt;br&gt;&lt;br&gt;El simulador manda cada 5 s: son 60 lecturas perdidas seguidas, ya no es un corte puntual. Es la misma constante que decide el estado ONLINE/OFFLINE del sensor, para que estado y alerta nunca se contradigan." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="470" height="160" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Cuenta created_at, no recorded_at&lt;/b&gt;&lt;br&gt;&lt;br&gt;Se mira cuándo llegó la lectura al backend, no la hora que dice el sensor. Un sensor que reenvía lecturas antiguas no debe parecer conectado." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="560" y="660" width="470" height="160" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Una sola alerta por sensor&lt;/b&gt;&lt;br&gt;&lt;br&gt;Si ya tiene una SENSOR_OFFLINE abierta, no se abre otra. Igual que con la presión: una alerta por problema, y solo la cierra una persona." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1060" y="660" width="480" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6 · Tarea de fondo: cómo por dentro"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;font style="font-size:22px"&gt;&lt;b&gt;6 · La tarea de fondo por dentro&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#555555"&gt;alerts/vigilante.py decide cuándo; alerts/offline.py decide qué. Azul: event loop. Verde: hilo del pool.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="70" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;lifespan&lt;/b&gt; → asyncio.create_task(vigilar())" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="330" height="70" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;vigilar()&lt;/b&gt; · bucle infinito&lt;br&gt;&lt;font face="Courier New"&gt;while True:&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="330" height="80" as="geometry"/></mxCell><mxCell id="c4" value='&lt;font face="Courier New"&gt;await asyncio.to_thread(una_vuelta)&lt;/font&gt;&lt;br&gt;manda la ronda a un hilo' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="330" height="80" as="geometry"/></mxCell><mxCell id="c5" value='&lt;font face="Courier New"&gt;await asyncio.sleep(60)&lt;/font&gt;&lt;br&gt;duerme 1 min sin bloquear nada' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="330" height="80" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="otra vuelta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="una_vuelta() · en un hilo del pool" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fontSize=14;fontStyle=1;rounded=1;arcSize=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="120" width="520" height="430" as="geometry"/></mxCell><mxCell id="c10" value='&lt;font face="Courier New"&gt;db = SessionLocal()&lt;/font&gt; · su propia sesión' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="490" y="170" width="460" height="60" as="geometry"/></mxCell><mxCell id="c11" value='&lt;font face="Courier New"&gt;detectar_sensores_mudos(db)&lt;/font&gt;&lt;br&gt;→ cuántas alertas ha abierto' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="490" y="250" width="460" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;except&lt;/b&gt;: escribe el error en el log y devuelve 0.&lt;br&gt;Un fallo no para la vigilancia: se reintenta en la siguiente vuelta." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="490" y="340" width="460" height="80" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;finally&lt;/b&gt;: &lt;font face="Courier New"&gt;db.close()&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="490" y="440" width="460" height="60" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="to_thread" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="resultado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c13" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="detectar_sensores_mudos(db, ahora) · alerts/offline.py" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fontSize=14;fontStyle=1;rounded=1;arcSize=2;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1040" y="120" width="600" height="560" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;1&lt;/b&gt; · Última lectura de cada sensor en &lt;b&gt;una&lt;/b&gt; consulta:&lt;br&gt;&lt;font face="Courier New"&gt;MAX(created_at) GROUP BY sensor_id&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="1070" y="170" width="540" height="80" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;2&lt;/b&gt; · Candidatos: sensores &lt;b&gt;activos&lt;/b&gt;, que han mandado &lt;b&gt;alguna&lt;/b&gt; lectura (el JOIN deja fuera a los que nunca han mandado) y &lt;b&gt;sin&lt;/b&gt; SENSOR_OFFLINE ACTIVE abierta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="1070" y="270" width="540" height="110" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;3&lt;/b&gt; · En Python: ¿última lectura &amp;lt; ahora − 5 min?&lt;br&gt;&lt;font color="#555555"&gt;Se compara aquí y no en SQL porque SQLite (tests) guarda fechas sin zona y la comparación daría resultados falsos sin avisar.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="1070" y="400" width="540" height="110" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;4&lt;/b&gt; · En una transacción, una alerta por sensor mudo:&lt;br&gt;SENSOR_OFFLINE · &lt;b&gt;CRITICAL&lt;/b&gt;&lt;br&gt;«Sin lecturas desde el 10-10 a las 14:32 UTC (más de 5 minutos)»" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="1070" y="530" width="540" height="120" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="c11" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1260" y="720" width="160" height="100" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c21" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Ejemplo: S1 manda su última lectura a las 10:00:00 y se desconecta&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="900" height="30" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Ronda 10:01&lt;/b&gt;&lt;br&gt;lleva callado 1 min&lt;br&gt;no" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="810" width="210" height="100" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Ronda 10:03&lt;/b&gt;&lt;br&gt;lleva callado 3 min&lt;br&gt;no" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="810" width="210" height="100" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Ronda 10:05&lt;/b&gt;&lt;br&gt;lleva callado 5 min&lt;br&gt;no: tiene que ser MÁS de 5" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="520" y="810" width="210" height="100" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Ronda 10:06&lt;/b&gt;&lt;br&gt;lleva callado 6 min&lt;br&gt;SÍ: abre SENSOR_OFFLINE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="750" y="810" width="210" height="100" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Ronda 10:07&lt;/b&gt;&lt;br&gt;lleva callado 7 min&lt;br&gt;no: ya tiene una abierta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="980" y="810" width="210" height="100" as="geometry"/></mxCell><mxCell id="c34" value="La alerta aparece entre 5 y 6 minutos después de que el sensor se calle. El minuto de más es porque la ronda es cada minuto." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="940" width="1130" height="70" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Lo que conviene saber&lt;/b&gt;&lt;br&gt;&lt;br&gt;· Es una &lt;b&gt;tarea asyncio&lt;/b&gt;, no un hilo ni un «monitor». Solo la consulta va a un hilo.&lt;br&gt;&lt;br&gt;· Hoy el backend corre en &lt;b&gt;un solo proceso&lt;/b&gt;. Con varios, cada uno lanzaría su vigilante y en un caso raro podrían duplicar alertas. Está anotado en vigilante.py.&lt;br&gt;&lt;br&gt;· Un sensor que nunca ha mandado nada no recibe alerta, pero su estado sí sale OFFLINE." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1240" y="860" width="400" height="290" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;En una frase:&lt;/b&gt; como un sensor desconectado no avisa, el backend tiene un vigilante que arranca con la app (lifespan) y cada minuto busca sensores activos con más de 5 minutos sin lecturas, y les abre una alerta crítica, una sola por sensor. Duerme con await sleep sin bloquear y manda su consulta a un hilo con to_thread." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="1040" width="1130" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>