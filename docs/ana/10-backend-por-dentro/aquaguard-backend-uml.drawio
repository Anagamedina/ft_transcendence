eColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Máquina de estados de una alerta" style="text;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1100" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Lo que ve la app (entre paréntesis, lo que guarda la base de datos). Los avisos y el cierre los hace el vigilante cada minuto." style="text;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;fillColor=#000000;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="245" width="30" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Sin atender&lt;/b&gt;&lt;br&gt;(ACTIVE)" style="rounded=1;arcSize=40;whiteSpace=wrap;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;html=1;" vertex="1" parent="1"><mxGeometry x="260" y="225" width="180" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;En curso&lt;/b&gt;&lt;br&gt;(ACTIVE + acknowledged_at)" style="rounded=1;arcSize=40;whiteSpace=wrap;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;html=1;" vertex="1" parent="1"><mxGeometry x="620" y="225" width="200" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Arreglada&lt;/b&gt;&lt;br&gt;(RESOLVED)" style="rounded=1;arcSize=40;whiteSpace=wrap;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;html=1;" vertex="1" parent="1"><mxGeometry x="620" y="460" width="200" height="70" as="geometry"/></mxCell><mxCell id="c7" value="" style="ellipse;shape=endState;fillColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="705" y="620" width="30" height="30" as="geometry"/></mxCell><mxCell id="e8" value="lectura fuera de umbral&#xa;o sensor mudo &gt; 5 min" style="html=1;endArrow=open;endSize=10;fontSize=12;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="«Me encargo» (cliente)" style="html=1;endArrow=open;endSize=10;fontSize=12;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="15 min normales&#xa;o el admin la cierra" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=10;fontSize=12;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="15 min normales&#xa;o el admin la cierra" style="html=1;endArrow=open;endSize=10;fontSize=12;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="html=1;endArrow=open;endSize=10;fontSize=12;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="lectura peor → empeora" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=10;fontSize=12;exitX=0.25;exitY=0;entryX=0.75;entryY=0;" edge="1" parent="1" source="c4" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Severidad&lt;/b&gt; (alerts/rules.py)&lt;br&gt;Fuera del umbral → WARNING (leve)&lt;br&gt;Más de un 20 % fuera → CRITICAL&lt;br&gt;SENSOR_OFFLINE → siempre CRITICAL&lt;br&gt;Una sola alerta abierta por sensor y tipo" style="shape=note;size=16;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="330" height="120" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Avisos mientras está Sin atender&lt;/b&gt; (alerts/notices.py)&lt;br&gt;CRITICAL: email a los 5 y 20 min, llamada a los 45&lt;br&gt;WARNING: email a los 60 min&lt;br&gt;Se apunta en alert_notifications antes de enviar: nunca se repite&lt;br&gt;No se avisa mientras el cierre automático confirma" style="shape=note;size=16;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="460" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="7 · Estados: organización" id="p7"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Máquina de estados de una organización" style="text;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1100" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Cualquier otro cambio responde 409 con su código. Pasar de TRIAL a ACTIVE solo se hace contratando (subscribe)." style="text;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;fillColor=#000000;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="225" width="30" height="30" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;fillColor=#000000;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="325" width="30" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;TRIAL&lt;/b&gt;&lt;br&gt;prueba de 7 días" style="rounded=1;arcSize=40;whiteSpace=wrap;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;html=1;" vertex="1" parent="1"><mxGeometry x="260" y="205" width="180" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;ACTIVE&lt;/b&gt;&lt;br&gt;cliente con contrato" style="rounded=1;arcSize=40;whiteSpace=wrap;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;html=1;" vertex="1" parent="1"><mxGeometry x="660" y="205" width="180" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;SUSPENDED&lt;/b&gt;&lt;br&gt;nadie puede entrar" style="rounded=1;arcSize=40;whiteSpace=wrap;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;html=1;" vertex="1" parent="1"><mxGeometry x="460" y="465" width="180" height="70" as="geometry"/></mxCell><mxCell id="c8" value="" style="ellipse;shape=endState;fillColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="935" y="345" width="30" height="30" as="geometry"/></mxCell><mxCell id="e9" value="registro público (B10)" style="html=1;endArrow=open;endSize=10;fontSize=12;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="alta por el admin (B1)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=10;fontSize=12;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="subscribe (cliente)" style="html=1;endArrow=open;endSize=10;fontSize=12;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="extend-trial (+7 días)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=10;fontSize=12;exitX=0.25;exitY=0;entryX=0.75;entryY=0;" edge="1" parent="1" source="c5" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="suspend" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=10;fontSize=12;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="suspend" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=10;fontSize=12;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="reactivate&#xa;(si estaba en prueba)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=10;fontSize=12;exitX=0.25;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="reactivate" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=10;fontSize=12;exitX=0.75;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="delete (purge)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=10;fontSize=12;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Prueba vencida&lt;/b&gt; (organizations/trial.py)&lt;br&gt;TRIAL con trial_ends_at pasado: se calcula, no se guarda.&lt;br&gt;La cuenta queda en solo lectura: 403 TRIAL_EXPIRED en las escrituras&lt;br&gt;hasta que contrata o el admin amplía la prueba." style="shape=note;size=16;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="520" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="8 · Actividad: vigilante" id="p8"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Actividad del vigilante (alerts/vigilante.py)" style="text;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1100" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Tarea asyncio que arranca con la app. Cada vuelta corre en un hilo (asyncio.to_thread) con su propia sesión de BD. Un fallo se anota en el log y no para la siguiente." style="text;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;fillColor=#000000;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="395" y="100" width="30" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Sensores mudos&lt;/b&gt;&lt;br&gt;&lt;small&gt;offline.py: activo, emitió alguna vez y &gt; 5 min sin lecturas → SENSOR_OFFLINE crítica&lt;/small&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="260" y="170" width="300" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Cierre automático&lt;/b&gt;&lt;br&gt;&lt;small&gt;autoclose.py: 15 min seguidos normales → RESOLVED, resolved_at = primera lectura normal&lt;/small&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="260" y="290" width="300" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Avisos al cliente&lt;/b&gt;&lt;br&gt;&lt;small&gt;notices.py: apuntar en alert_notifications y enviar el email que toca&lt;/small&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="260" y="410" width="300" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Esperar&lt;/b&gt;&lt;br&gt;&lt;small&gt;asyncio.sleep(COMPROBAR_CADA = 1 min)&lt;/small&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="260" y="530" width="300" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Fallo en una vuelta&lt;/b&gt;&lt;br&gt;&lt;small&gt;logger.exception y se sigue&lt;/small&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="640" y="290" width="240" height="80" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=12;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=12;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=12;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=12;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="otra vuelta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=12;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="excepción" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=12;dashed=1;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Avisos: qué email toca&lt;/b&gt;&lt;br&gt;Alertas ACTIVE sin acknowledged_at&lt;br&gt;CRITICAL: intento 1 a los 5 min, intento 2 a los 20&lt;br&gt;WARNING: intento 1 a los 60 min&lt;br&gt;Intento 1 → contacto de la organización&lt;br&gt;Intento 2 → contacto + usuarios activos&lt;br&gt;Si ya está confirmando el cierre, no se avisa&lt;br&gt;UNIQUE (alert_id, attempt): nunca se repite&lt;br&gt;A los 45 min el admin ve «llama al cliente»" style="shape=note;size=16;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;html=1;" vertex="1" parent="1"><mxGeometry x="640" y="410" width="380" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="9 · Normas y números" id="p9"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Normas y números del backend de Ana" style="text;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1100" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Cada valor con su constante y su archivo (rutas desde backend/app/)." style="text;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Alertas y sensores" style="text;fontSize=16;fontStyle=1;align=left;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="700" height="26" as="geometry"/></mxCell><mxCell id="c4" value="&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:12px'&gt;&lt;tr&gt;&lt;th&gt;Regla&lt;/th&gt;&lt;th&gt;Valor&lt;/th&gt;&lt;th&gt;Dónde&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Margen para crítica&lt;/td&gt;&lt;td&gt;&lt;b&gt;20 %&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;alerts/rules.py · MARGEN_CRITICO&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Rango de presión y umbrales&lt;/td&gt;&lt;td&gt;&lt;b&gt;0 a 25 bar&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;sensors/schemas.py · PRESSURE_MIN/MAX_BAR&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Sensor sin conexión&lt;/td&gt;&lt;td&gt;&lt;b&gt;&gt; 5 min&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;sensors/status.py · OFFLINE_TRAS&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Vigilante&lt;/td&gt;&lt;td&gt;&lt;b&gt;cada 1 min&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;alerts/vigilante.py · COMPROBAR_CADA&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Avisos críticos&lt;/td&gt;&lt;td&gt;&lt;b&gt;5 y 20 min; llamada 45&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;alerts/notices.py · CALENDARIO&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Aviso leve&lt;/td&gt;&lt;td&gt;&lt;b&gt;60 min&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;alerts/notices.py · CALENDARIO&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Cierre automático&lt;/td&gt;&lt;td&gt;&lt;b&gt;15 min normales&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;alerts/autoclose.py · CONFIRMAR_DURANTE&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Alertas abiertas por sensor y tipo&lt;/td&gt;&lt;td&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;readings/service.py · _aplicar_reglas&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Puntos de una serie&lt;/td&gt;&lt;td&gt;&lt;b&gt;1.000&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;readings/service.py · MAX_SERIES_POINTS&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Plantas / sótanos&lt;/td&gt;&lt;td&gt;&lt;b&gt;≤ 200 / ≤ 20&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;sites/schemas.py · FLOORS_MAX, BASEMENTS_MAX&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="700" height="330" as="geometry"/></mxCell><mxCell id="c5" value="Autenticación y contraseñas" style="text;fontSize=16;fontStyle=1;align=left;html=1;" vertex="1" parent="1"><mxGeometry x="760" y="80" width="700" height="26" as="geometry"/></mxCell><mxCell id="c6" value="&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:12px'&gt;&lt;tr&gt;&lt;th&gt;Regla&lt;/th&gt;&lt;th&gt;Valor&lt;/th&gt;&lt;th&gt;Dónde&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Sesión&lt;/td&gt;&lt;td&gt;&lt;b&gt;8 h&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;core/security.py · SESSION_MAX_AGE_SECONDS&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Cookie&lt;/td&gt;&lt;td&gt;&lt;b&gt;httpOnly, Secure, SameSite=lax&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;core/security.py · session_cookie_kwargs&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Hash&lt;/td&gt;&lt;td&gt;&lt;b&gt;Argon2id + sal por usuario&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;core/security.py · PasswordHasher&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Longitud de contraseña&lt;/td&gt;&lt;td&gt;&lt;b&gt;12 a 128&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;shared/passwords.py · PASSWORD_MIN/MAX_LENGTH&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Caracteres distintos&lt;/td&gt;&lt;td&gt;&lt;b&gt;≥ 5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;shared/passwords.py · _MINIMO_DISTINTOS&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Email en la contraseña&lt;/td&gt;&lt;td&gt;&lt;b&gt;prohibido (usuario ≥ 4 letras)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;shared/passwords.py · check_password&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Email&lt;/td&gt;&lt;td&gt;&lt;b&gt;minúsculas, sin espacios&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;users/repository.py · normalize_email&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Login con email inexistente&lt;/td&gt;&lt;td&gt;&lt;b&gt;mismo mensaje y tiempo&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;auth/service.py · _HUELLA_SENUELO&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Clave del simulador&lt;/td&gt;&lt;td&gt;&lt;b&gt;X-Ingest-Key, tiempo constante&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;shared/dependencies.py · require_ingest_key&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="700" height="300" as="geometry"/></mxCell><mxCell id="c7" value="Cuentas y contrato común" style="text;fontSize=16;fontStyle=1;align=left;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="700" height="26" as="geometry"/></mxCell><mxCell id="c8" value="&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:12px'&gt;&lt;tr&gt;&lt;th&gt;Regla&lt;/th&gt;&lt;th&gt;Valor&lt;/th&gt;&lt;th&gt;Dónde&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Prueba&lt;/td&gt;&lt;td&gt;&lt;b&gt;7 días&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;core/app_config.py · TRIAL_DAYS&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Prueba vencida&lt;/td&gt;&lt;td&gt;&lt;b&gt;solo lectura · 403 TRIAL_EXPIRED&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;shared/dependencies.py · require_trial_not_expired&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Invitación&lt;/td&gt;&lt;td&gt;&lt;b&gt;7 días&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;core/app_config.py · INVITATION_TTL_DAYS&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Cuenta desactivada&lt;/td&gt;&lt;td&gt;&lt;b&gt;403 ACCOUNT_DISABLED&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;shared/dependencies.py · ensure_account_enabled&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Paginación&lt;/td&gt;&lt;td&gt;&lt;b&gt;page ≥ 1 · page_size 20, máx. 100&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;shared/dependencies.py · PaginationParams&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Rango de fechas&lt;/td&gt;&lt;td&gt;&lt;b&gt;30 días, máx. 366&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;shared/dependencies.py · DateRangeParams&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Búsqueda&lt;/td&gt;&lt;td&gt;&lt;b&gt;q de 2 a 100 · ≤ 20 por tipo&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;search/router.py · Q_MIN&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Formato de error&lt;/td&gt;&lt;td&gt;&lt;b&gt;error → code, message, details&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;core/exceptions.py · AppError&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Status&lt;/td&gt;&lt;td&gt;&lt;b&gt;401 · 403 · 404 (también de otro) · 409 · 422&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;core/exceptions.py&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="700" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>