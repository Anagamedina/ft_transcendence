<mxfile host="app.diagrams.net"><diagram id="p0" name="0 · Índice"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;font style="font-size:22px"&gt;&lt;b&gt;AquaGuard · cómo hablan el frontend y el backend&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#555555"&gt;Cómo llegan los datos a la pantalla, por dónde viajan, cómo funciona el MockAdapter y cómo está desacoplado. Hecho a partir del código de develop (PR #181).&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="70" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Pestañas&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1 · Despliegue&lt;/b&gt;: navegador, gateway nginx, backend y base de datos. Producción y desarrollo.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 · Capas del frontend (UML)&lt;/b&gt;: View → Store → Service → Adapter → Http | Mock.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 · Cómo llegan los datos a la pantalla&lt;/b&gt;: el dashboard del admin, paso a paso.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 · El contrato: sesión, JSON y errores&lt;/b&gt;: qué viaja entre los dos lados.&lt;br&gt;&lt;br&gt;&lt;b&gt;5 · El MockAdapter&lt;/b&gt;: cómo se hizo y por qué.&lt;br&gt;&lt;br&gt;&lt;b&gt;6 · Desacoplamiento&lt;/b&gt;: qué está desacoplado, qué no, y cómo quitar el mock.&lt;br&gt;&lt;br&gt;&lt;b&gt;7 · CORS&lt;/b&gt;: qué es y cómo está configurado.&lt;br&gt;&lt;br&gt;&lt;b&gt;8 · CORS en AquaGuard&lt;/b&gt;: cuándo actúa de verdad." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="680" height="470" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="560" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Frontend (Vue, en el navegador)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="760" y="160" width="300" height="46" as="geometry"/></mxCell><mxCell id="c5" value="Backend (FastAPI)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="216" width="300" height="46" as="geometry"/></mxCell><mxCell id="c6" value="Infraestructura (nginx, Vite, Docker)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="760" y="272" width="300" height="46" as="geometry"/></mxCell><mxCell id="c7" value="Mock (datos falsos)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="760" y="328" width="300" height="46" as="geometry"/></mxCell><mxCell id="c8" value="Nota / explicación" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="760" y="384" width="300" height="46" as="geometry"/></mxCell><mxCell id="c9" value="Riesgo / problema" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="760" y="440" width="300" height="46" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Notación UML (pestaña 2)&lt;/b&gt;&lt;br&gt;&lt;br&gt;── ▶ usa / llama&lt;br&gt;&lt;br&gt;- - ▷ implementa (realiza la interfaz)&lt;br&gt;&lt;br&gt;«view», «store», «service», «interface», «adapter»: el papel de cada pieza" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1090" y="160" width="270" height="326" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="1 · Despliegue"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;font style="font-size:22px"&gt;&lt;b&gt;1 · Por dónde viaja una petición&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#555555"&gt;El navegador nunca habla directamente con el backend: siempre pasa por un intermediario que sirve el frontend y reenvía /api al backend. Así todo sale del mismo origen.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="70" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;En producción: docker compose (compose.yaml)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="800" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;la app Vue ya compilada&lt;br&gt;(HTML + JS)&lt;br&gt;&lt;br&gt;https://localhost" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="260" height="140" as="geometry"/></mxCell><mxCell id="c4" value="gateway · nginx (puertos 80 y 443)" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fontSize=14;fontStyle=1;rounded=1;arcSize=2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="380" y="140" width="520" height="400" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;location /&lt;/b&gt;&lt;br&gt;sirve los archivos de &lt;font face="Courier New"&gt;/usr/share/nginx/html&lt;/font&gt; (el &lt;i&gt;npm run build&lt;/i&gt; del frontend)' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="410" y="190" width="460" height="80" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;location /api/&lt;/b&gt; → &lt;font face="Courier New"&gt;proxy_pass http://backend:8000&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="410" y="290" width="460" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;location /ws/&lt;/b&gt; → backend (WebSocket, preparado)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="410" y="380" width="460" height="60" as="geometry"/></mxCell><mxCell id="c8" value="El puerto 80 redirige a 443 (HTTPS). El backend no publica ningún puerto hacia fuera." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="455" width="460" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;backend&lt;/b&gt;&lt;br&gt;Uvicorn + FastAPI&lt;br&gt;puerto 8000 (solo red interna)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="990" y="270" width="260" height="110" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;database&lt;/b&gt;&lt;br&gt;PostgreSQL 16" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1340" y="270" width="170" height="110" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;simulator&lt;/b&gt;&lt;br&gt;POST /api/readings + X-Ingest-Key" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="990" y="450" width="260" height="80" as="geometry"/></mxCell><mxCell id="c12" value="GET /  (la app)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="/api + cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="proxy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="red interna" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c11" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;gateway/Dockerfile&lt;/b&gt; compila el frontend (&lt;i&gt;npm run build&lt;/i&gt;) y copia el resultado en nginx.&lt;br&gt;&lt;br&gt;Sin VITE_USE_MOCK en el build → usa el &lt;b&gt;HttpAdapter&lt;/b&gt;. VITE_API_URL vacío → las llamadas van a /api del mismo origen." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="300" height="210" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;En desarrollo: npm run dev (frontend/vite.config.js)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="800" height="30" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;http://localhost:5173" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="260" height="110" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Servidor de desarrollo de Vite&lt;/b&gt; (puerto 5173)&lt;br&gt;sirve la app con recarga en caliente&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;proxy: '/api/' → http://localhost:8000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="380" y="630" width="520" height="130" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;backend&lt;/b&gt;&lt;br&gt;localhost:8000" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="990" y="640" width="260" height="110" as="geometry"/></mxCell><mxCell id="c22" value="/ y /api/..." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="reenvía /api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;Por qué un intermediario y no llamar directo al :8000&lt;/b&gt;&lt;br&gt;&lt;br&gt;· El navegador ve &lt;b&gt;un solo origen&lt;/b&gt; (mismo esquema, host y puerto). La cookie de sesión viaja sola y no hace falta CORS.&lt;br&gt;&lt;br&gt;· El backend queda escondido en la red interna de Docker: solo se llega a él por nginx.&lt;br&gt;&lt;br&gt;· El frontend no necesita saber dónde está el backend: llama a &lt;font face="Courier New"&gt;/api/...&lt;/font&gt; y listo.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="790" height="260" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b&gt;¿Y el CORS del backend? (main.py)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hace falta solo si el frontend llama a otro origen, por ejemplo con VITE_API_URL=http://localhost:8000.&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;CORSMiddleware(allow_origins=CORS_ORIGINS,&lt;br&gt;&amp;nbsp;&amp;nbsp;allow_credentials=True, ...)&lt;/font&gt;&lt;br&gt;&lt;br&gt;allow_credentials=True es imprescindible para que el navegador envíe la cookie. Con credenciales no se puede usar "*": hay que listar los orígenes (por defecto :5173 y :3000).' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="870" y="820" width="790" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2 · Capas del frontend (UML)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;font style="font-size:22px"&gt;&lt;b&gt;2 · Diagrama de clases: de la pantalla a la red&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#555555"&gt;Cada capa solo conoce a la de debajo. La pantalla no sabe que existe Axios, y los services no saben si detrás hay un backend real o un mock.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1740" height="70" as="geometry"/></mxCell><mxCell id="c2" value='&lt;div style="text-align:center"&gt;&lt;i&gt;«view»&lt;/i&gt;&lt;br&gt;&lt;b&gt;admin/DashboardView.vue&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;sensorStore = useSensorsStore()&lt;br&gt;alertsStore = useAlertsStore()&lt;br&gt;totalSensors: computed&lt;br&gt;sensorsReady: computed&lt;hr&gt;onMounted() → loadSensors(), loadAlerts()&lt;br&gt;pinta KPIs, lista, mapa' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="380" height="230" as="geometry"/></mxCell><mxCell id="c3" value='&lt;div style="text-align:center"&gt;&lt;i&gt;«store · Pinia»&lt;/i&gt;&lt;br&gt;&lt;b&gt;useSensorsStore&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;sensors: ref([])&lt;br&gt;selectedSensor: ref(null)&lt;br&gt;status: idle | loading | success | error&lt;br&gt;error: {code, message, details}&lt;br&gt;sensorCount: computed&lt;hr&gt;fetchSensors()&lt;br&gt;selectSensor(sensor)&lt;br&gt;clearSensors()' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="120" width="400" height="260" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="text-align:center"&gt;&lt;i&gt;«service»&lt;/i&gt;&lt;br&gt;&lt;b&gt;sensorsService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;getSensors() → GET /api/sensors&lt;br&gt;getSensor(id) → GET /api/sensors/{id}&lt;br&gt;createSensor(data) → POST /api/sensors&lt;br&gt;updateSensor(id, data) → PATCH /api/sensors/{id}' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="120" width="380" height="230" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Los demás services siguen el mismo patrón&lt;/b&gt;&lt;br&gt;authService · alertService · siteService · readingService&lt;br&gt;(cada uno con su store: auth, alerts, readings)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;align=left;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="120" width="330" height="130" as="geometry"/></mxCell><mxCell id="c6" value='&lt;div style="text-align:center"&gt;&lt;i&gt;«interface · adapter.js»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Adapter&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;i&gt;elegido una vez al arrancar:&lt;/i&gt;&lt;br&gt;VITE_USE_MOCK === "true"&lt;br&gt;  ? mockAdapter : httpAdapter&lt;hr&gt;get(url, config)&lt;br&gt;post(url, data, config)&lt;br&gt;patch(url, data, config)&lt;br&gt;delete(url, config)' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="560" width="380" height="200" as="geometry"/></mxCell><mxCell id="c7" value='&lt;div style="text-align:center"&gt;&lt;i&gt;«adapter»&lt;/i&gt;&lt;br&gt;&lt;b&gt;httpAdapter&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;get / post / patch / delete&lt;br&gt;  try: return await api.get(...)&lt;br&gt;  catch: throw normalizeError(error)&lt;br&gt;normalizeError(error) → {status, code, message, details}' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="860" width="420" height="250" as="geometry"/></mxCell><mxCell id="c8" value='&lt;div style="text-align:center"&gt;&lt;i&gt;«adapter»&lt;/i&gt;&lt;br&gt;&lt;b&gt;mockAdapter&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;fixtures: sites, sensors, readings, alerts&lt;br&gt;mockUser[]: admin y client&lt;br&gt;currentUser (localStorage)&lt;hr&gt;get / post / patch / delete&lt;br&gt;  if url === "/api/sensors" → Promise.resolve({data, status})&lt;br&gt;  error → Promise.reject({status, code, message, details})' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacing=8;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="860" width="420" height="250" as="geometry"/></mxCell><mxCell id="c9" value='&lt;div style="text-align:center"&gt;&lt;i&gt;«cliente HTTP · api.js»&lt;/i&gt;&lt;br&gt;&lt;b&gt;axios.create({ baseURL, timeout: 10000, withCredentials: true })&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;&amp;nbsp;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="1150" width="420" height="80" as="geometry"/></mxCell><mxCell id="c10" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="adapter.get(...)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endFill=0;endArrow=block;endSize=14;exitX=0.5;exitY=0;entryX=0.2;entryY=1;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endFill=0;endArrow=block;endSize=14;exitX=0.5;exitY=0;entryX=0.8;entryY=1;" edge="1" parent="1" source="c8" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;Qué hace cada capa&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;View&lt;/b&gt;: pinta. Lee el store y llama a sus acciones. No sabe de HTTP.&lt;br&gt;&lt;br&gt;&lt;b&gt;Store (Pinia)&lt;/b&gt;: guarda el estado reactivo (los datos, si está cargando, el error). Cuando cambia, Vue repinta solo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Service&lt;/b&gt;: traduce «dame los sensores» en una ruta de la API. Un método por endpoint.&lt;br&gt;&lt;br&gt;&lt;b&gt;Adapter&lt;/b&gt;: hace la llamada de verdad (o la finge) y devuelve siempre la misma forma: &lt;font face="Courier New"&gt;{data, status}&lt;/font&gt; o un error &lt;font face="Courier New"&gt;{status, code, message, details}&lt;/font&gt;.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="420" height="380" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;El patrón se llama Adapter&lt;/b&gt;&lt;br&gt;&lt;br&gt;Los services dependen de una &lt;b&gt;interfaz&lt;/b&gt; (get, post, patch, delete), no de Axios. Dos implementaciones cumplen esa interfaz y se elige una al arrancar. Cambiar de una a otra no toca ni views, ni stores, ni services." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="460" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3 · Cómo llegan los datos a la pantalla"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2260" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;font style="font-size:22px"&gt;&lt;b&gt;3 · El admin abre su panel: de la URL a los KPIs&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#555555"&gt;Diagrama de secuencia. Cada columna es una pieza; cada flecha, una llamada. Las flechas discontinuas son respuestas.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2180" height="70" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Navegador / router&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="200" height="60" as="geometry"/></mxCell><mxCell id="c3" value="" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="160" as="sourcePoint"/><mxPoint x="140" y="1530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" value="&lt;b&gt;DashboardView&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="280" y="100" width="200" height="60" as="geometry"/></mxCell><mxCell id="c5" value="" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="160" as="sourcePoint"/><mxPoint x="380" y="1530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="&lt;b&gt;useSensorsStore&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="200" height="60" as="geometry"/></mxCell><mxCell id="c7" value="" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="160" as="sourcePoint"/><mxPoint x="620" y="1530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;sensorsService&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="200" height="60" as="geometry"/></mxCell><mxCell id="c9" value="" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="160" as="sourcePoint"/><mxPoint x="860" y="1530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;adapter → httpAdapter&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="200" height="60" as="geometry"/></mxCell><mxCell id="c11" value="" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="160" as="sourcePoint"/><mxPoint x="1100" y="1530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;nginx&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1240" y="100" width="200" height="60" as="geometry"/></mxCell><mxCell id="c13" value="" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="160" as="sourcePoint"/><mxPoint x="1340" y="1530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;Backend FastAPI&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1480" y="100" width="200" height="60" as="geometry"/></mxCell><mxCell id="c15" value="" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="160" as="sourcePoint"/><mxPoint x="1580" y="1530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1720" y="100" width="200" height="60" as="geometry"/></mxCell><mxCell id="c17" value="" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1820" y="160" as="sourcePoint"/><mxPoint x="1820" y="1530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="200" as="sourcePoint"/><mxPoint x="140" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="router.beforeEach:&lt;br&gt;authStore.initializeAuth()&lt;br&gt;→ GET /api/me con la cookie&lt;br&gt;(¿quién soy? ¿admin?)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="220" height="90" as="geometry"/></mxCell><mxCell id="c20" value="monta la vista /admin" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="310" as="sourcePoint"/><mxPoint x="380" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="onMounted() → loadSensors()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="360" width="220" height="50" as="geometry"/></mxCell><mxCell id="c22" value="fetchSensors()" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="430" as="sourcePoint"/><mxPoint x="620" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value='status = "loading"&lt;br&gt;→ la vista enseña LoadingState' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="470" width="220" height="50" as="geometry"/></mxCell><mxCell id="c24" value="getSensors()" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="540" as="sourcePoint"/><mxPoint x="860" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="adapter.get('/api/sensors')" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="590" as="sourcePoint"/><mxPoint x="1100" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="axios: baseURL + /api/sensors&lt;br&gt;withCredentials: la cookie viaja" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="640" width="220" height="60" as="geometry"/></mxCell><mxCell id="c27" value="GET /api/sensors + cookie" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="720" as="sourcePoint"/><mxPoint x="1340" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="proxy_pass backend:8000" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="770" as="sourcePoint"/><mxPoint x="1580" y="770" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="get_current_user (cookie)&lt;br&gt;get_org_scope (admin: None)&lt;br&gt;router → service → repository" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1470" y="810" width="220" height="100" as="geometry"/></mxCell><mxCell id="c30" value="SELECT" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="930" as="sourcePoint"/><mxPoint x="1820" y="930" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="filas" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1820" y="980" as="sourcePoint"/><mxPoint x="1580" y="980" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="schema → JSON&lt;br&gt;{items, total, page, page_size, pages}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1470" y="1030" width="220" height="60" as="geometry"/></mxCell><mxCell id="c33" value="200 OK + JSON" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="1110" as="sourcePoint"/><mxPoint x="1340" y="1110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="200 OK + JSON" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="1160" as="sourcePoint"/><mxPoint x="1100" y="1160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="response = {data, status}" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="1210" as="sourcePoint"/><mxPoint x="860" y="1210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="response" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1260" as="sourcePoint"/><mxPoint x="620" y="1260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value='sensors.value = response.data.items&lt;br&gt;status = "success"' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="1300" width="220" height="70" as="geometry"/></mxCell><mxCell id="c38" value="reactividad de Vue" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1390" as="sourcePoint"/><mxPoint x="380" y="1390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="computed se recalculan:&lt;br&gt;totalSensors, ONLINE, mapa&lt;br&gt;→ &lt;b&gt;los datos aparecen&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="1430" width="220" height="90" as="geometry"/></mxCell><mxCell id="c40" value='&lt;b&gt;La clave: reactividad&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nadie «manda pintar» la pantalla. La vista lee &lt;font face="Courier New"&gt;sensorStore.sensors&lt;/font&gt; y &lt;font face="Courier New"&gt;status&lt;/font&gt;.&lt;br&gt;&lt;br&gt;Son &lt;font face="Courier New"&gt;ref()&lt;/font&gt; de Vue: cuando el store les asigna un valor nuevo, Vue detecta el cambio y repinta lo que depende de ellos.&lt;br&gt;&lt;br&gt;Mientras status es "loading" se ve el esqueleto de carga; con "success", los datos; con "error", el ErrorState con botón de reintentar.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1970" y="200" width="260" height="560" as="geometry"/></mxCell><mxCell id="c41" value='&lt;b&gt;Si algo falla&lt;/b&gt;&lt;br&gt;&lt;br&gt;El backend responde, por ejemplo, 401 con &lt;font face="Courier New"&gt;{"error": {...}}&lt;/font&gt;.&lt;br&gt;httpAdapter lo normaliza, el store guarda &lt;font face="Courier New"&gt;error&lt;/font&gt; y &lt;font face="Courier New"&gt;status="error"&lt;/font&gt;, y la vista enseña ErrorState. Ver la pestaña 4.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1970" y="790" width="260" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4 · El contrato: sesión, JSON y errores"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;font style="font-size:22px"&gt;&lt;b&gt;4 · Qué viaja entre el frontend y el backend&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#555555"&gt;Los dos lados solo comparten un contrato: rutas, formato JSON, cookie de sesión y formato de error. Está escrito en OpenAPI (Swagger en /api/docs).&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="70" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;La sesión: login con cookie httpOnly&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;LoginView&lt;/b&gt; → authStore.login()&lt;br&gt;→ authService.login()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="280" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;POST /api/auth/login&lt;/b&gt;&lt;br&gt;{email, password}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="330" height="90" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Backend&lt;/b&gt;: verifica Argon2&lt;br&gt;responde &lt;font face="Courier New"&gt;{user: {...}}&lt;/font&gt;&lt;br&gt;+ &lt;b&gt;Set-Cookie: aquaguard_session&lt;/b&gt; (httpOnly, 8 h)' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="810" y="150" width="380" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Navegador&lt;/b&gt; guarda la cookie. JavaScript &lt;b&gt;no puede leerla&lt;/b&gt;. La envía solo en cada petición a /api." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1270" y="150" width="480" height="90" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value='Como el frontend no puede leer la cookie, para saber quién ha entrado llama a &lt;b&gt;GET /api/me&lt;/b&gt;. Lo hace el router en cada navegación protegida (&lt;font face="Courier New"&gt;router.beforeEach → initializeAuth&lt;/font&gt;). Si responde 401, el usuario no tiene sesión y va al login.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="850" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;¿Por qué cookie y no un token en el JSON?&lt;/b&gt; Si un ataque XSS inyecta JavaScript, no puede robar una cookie httpOnly. Decisión documentada en docs/decisions/0001-auth-cookie.md." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="930" y="270" width="820" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Las respuestas correctas: siempre la misma forma&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="900" height="30" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;Lista paginada&lt;/b&gt; (GET /api/sensors, /alerts, /sites)&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;"items": [ {...}, {...} ],&lt;br&gt;&amp;nbsp;&amp;nbsp;"total": 42,&lt;br&gt;&amp;nbsp;&amp;nbsp;"page": 1,&lt;br&gt;&amp;nbsp;&amp;nbsp;"page_size": 20,&lt;br&gt;&amp;nbsp;&amp;nbsp;"pages": 3&lt;br&gt;}&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;fontFamily=Courier New;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="560" height="230" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;Un recurso&lt;/b&gt; (GET /api/sensors/{id})&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;"id": "…",&lt;br&gt;&amp;nbsp;&amp;nbsp;"name": "Planta 2",&lt;br&gt;&amp;nbsp;&amp;nbsp;"min_pressure": 1.5,&lt;br&gt;&amp;nbsp;&amp;nbsp;"max_pressure": 10,&lt;br&gt;&amp;nbsp;&amp;nbsp;"status": "ONLINE"&lt;br&gt;}&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;fontFamily=Courier New;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="640" y="470" width="520" height="230" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;Lo que hace el store con ello&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;sensors.value = response.data.items&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;response&lt;/i&gt; es el objeto de Axios; &lt;i&gt;data&lt;/i&gt; es el JSON del backend; &lt;i&gt;items&lt;/i&gt; es la lista. Por eso el mock tiene que devolver exactamente &lt;font face="Courier New"&gt;{data: {items, ...}, status}&lt;/font&gt;.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="470" width="550" height="230" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Los errores: un formato en el backend, otro normalizado en el frontend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="900" height="30" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b&gt;Backend&lt;/b&gt; (core/exceptions.py)&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;HTTP 404&lt;br&gt;{"error": {&lt;br&gt;&amp;nbsp;&amp;nbsp;"code": "SENSOR_NOT_FOUND",&lt;br&gt;&amp;nbsp;&amp;nbsp;"message": "…",&lt;br&gt;&amp;nbsp;&amp;nbsp;"details": null}}&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="440" height="200" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;httpAdapter.normalizeError&lt;/b&gt;&lt;br&gt;&lt;br&gt;· Respuesta con error → &lt;font face="Courier New"&gt;{status, code, message, details}&lt;/font&gt;&lt;br&gt;· Sin respuesta → &lt;font face="Courier New"&gt;NETWORK_ERROR&lt;/font&gt;&lt;br&gt;· Fallo del propio Axios → &lt;font face="Courier New"&gt;CLIENT_ERROR&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="560" y="790" width="440" height="200" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;Store&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;error.value = {code, message, details}&lt;br&gt;status.value = "error"&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1080" y="790" width="330" height="200" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Vista&lt;/b&gt;&lt;br&gt;&lt;br&gt;ErrorState con el mensaje y un botón de reintentar.&lt;br&gt;401 → al login." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1490" y="790" width="260" height="200" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;La regla de oro:&lt;/b&gt; el frontend decide por &lt;font face="Courier New"&gt;code&lt;/font&gt; (estable: SENSOR_NOT_FOUND, UNAUTHORIZED…), nunca por el texto de &lt;font face="Courier New"&gt;message&lt;/font&gt;, que es para personas y puede cambiar.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="1710" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5 · El MockAdapter"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;font style="font-size:22px"&gt;&lt;b&gt;5 · El MockAdapter: el frontend sin backend&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#555555"&gt;Se hizo para que el frontend avanzara en paralelo durante la primera semana, antes de que existiera la API (frontend/src/services/mockAdapter.js).&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="70" as="geometry"/></mxCell><mxCell id="c2" value='&lt;b&gt;.env del frontend&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;VITE_USE_MOCK=true&lt;/font&gt;&lt;br&gt;&lt;font color="#555555"&gt;(se lee al arrancar o al compilar con Vite)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="400" height="130" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;adapter.js&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;const adapter =&lt;br&gt;&amp;nbsp;&amp;nbsp;VITE_USE_MOCK === 'true'&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;? mockAdapter : httpAdapter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;fontFamily=Courier New;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="460" height="130" as="geometry"/></mxCell><mxCell id="c4" value="decide" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;httpAdapter&lt;/b&gt; → Axios → backend real" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1100" y="80" width="330" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;mockAdapter&lt;/b&gt; → datos en memoria (fixtures)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1100" y="200" width="330" height="90" as="geometry"/></mxCell><mxCell id="c7" value="'false' o vacío" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="'true'" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Cómo está hecho por dentro&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="900" height="30" as="geometry"/></mxCell><mxCell id="c10" value="&lt;font face=&quot;Courier New&quot;&gt;const mockAdapter = {&lt;br&gt;&amp;nbsp;&amp;nbsp;get(url, config) {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if (url === '/api/me') {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if (!currentUser)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return Promise.reject({status: 401,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;code: 'UNAUTHORIZED', ...})&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return Promise.resolve({&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;data: { user: toPublicUser(currentUser) },&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;status: 200 })&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;}&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if (url === '/api/sensors')&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return Promise.resolve({ data: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;items: sensors, total, page: 1, ... },&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;status: 200 })&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;fontFamily=Courier New;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="560" height="330" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Las 5 reglas que cumple&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; Los mismos métodos que httpAdapter: get, post, patch, delete.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Devuelve Promesas, como una llamada de red de verdad.&lt;br&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Las mismas formas: &lt;font face="Courier New"&gt;{data, status}&lt;/font&gt; y listas &lt;font face="Courier New"&gt;{items, total, page, page_size, pages}&lt;/font&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Los errores ya normalizados: &lt;font face="Courier New"&gt;{status, code, message, details}&lt;/font&gt;, igual que normalizeError.&lt;br&gt;&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Datos de &lt;i&gt;fixtures/&lt;/i&gt; (sites, sensors, readings, alerts) y dos usuarios falsos (admin y client). La «sesión» se guarda en localStorage.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="640" y="340" width="540" height="330" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;De dónde salió el contrato&lt;/b&gt;&lt;br&gt;&lt;br&gt;El backend publicó los schemas en Swagger &lt;b&gt;antes&lt;/b&gt; de tener las rutas (openapi.py, #22 y #23). El frontend construyó el mock con esas formas reales.&lt;br&gt;&lt;br&gt;Si el mock hubiera devuelto &lt;font face="Courier New"&gt;data&lt;/font&gt; y la API &lt;font face="Courier New"&gt;items&lt;/font&gt;, todo habría funcionado semanas con el mock y se habría roto el día de integrar.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="340" width="530" height="330" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Comparación&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="900" height="30" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="300" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;httpAdapter&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;rounded=0;" vertex="1" parent="1"><mxGeometry x="340" y="750" width="520" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;mockAdapter&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;rounded=0;" vertex="1" parent="1"><mxGeometry x="860" y="750" width="520" height="50" as="geometry"/></mxCell><mxCell id="c17" value="¿Qué hace?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="806" width="300" height="50" as="geometry"/></mxCell><mxCell id="c18" value="Llamadas HTTP reales con Axios" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="340" y="806" width="520" height="50" as="geometry"/></mxCell><mxCell id="c19" value="Busca la URL con if y devuelve datos fijos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;rounded=0;" vertex="1" parent="1"><mxGeometry x="860" y="806" width="520" height="50" as="geometry"/></mxCell><mxCell id="c20" value="¿Necesita backend?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="300" height="50" as="geometry"/></mxCell><mxCell id="c21" value="Sí" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="340" y="862" width="520" height="50" as="geometry"/></mxCell><mxCell id="c22" value="No" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;rounded=0;" vertex="1" parent="1"><mxGeometry x="860" y="862" width="520" height="50" as="geometry"/></mxCell><mxCell id="c23" value="Sesión" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="918" width="300" height="50" as="geometry"/></mxCell><mxCell id="c24" value="Cookie httpOnly del backend" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="340" y="918" width="520" height="50" as="geometry"/></mxCell><mxCell id="c25" value="Id de usuario en localStorage" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;rounded=0;" vertex="1" parent="1"><mxGeometry x="860" y="918" width="520" height="50" as="geometry"/></mxCell><mxCell id="c26" value="Errores" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="974" width="300" height="50" as="geometry"/></mxCell><mxCell id="c27" value="normalizeError() a partir de la respuesta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="340" y="974" width="520" height="50" as="geometry"/></mxCell><mxCell id="c28" value="Ya los crea normalizados" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;rounded=0;" vertex="1" parent="1"><mxGeometry x="860" y="974" width="520" height="50" as="geometry"/></mxCell><mxCell id="c29" value="Datos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="300" height="50" as="geometry"/></mxCell><mxCell id="c30" value="PostgreSQL, filtrados por organización" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="340" y="1030" width="520" height="50" as="geometry"/></mxCell><mxCell id="c31" value="fixtures/*.js, sin filtrar" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;rounded=0;" vertex="1" parent="1"><mxGeometry x="860" y="1030" width="520" height="50" as="geometry"/></mxCell><mxCell id="c32" value="Uso" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="1086" width="300" height="50" as="geometry"/></mxCell><mxCell id="c33" value="Producción y pruebas de integración" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="340" y="1086" width="520" height="50" as="geometry"/></mxCell><mxCell id="c34" value="Desarrollo en paralelo, demos sin backend" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;rounded=0;" vertex="1" parent="1"><mxGeometry x="860" y="1086" width="520" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6 · Desacoplamiento"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;font style="font-size:22px"&gt;&lt;b&gt;6 · Qué está desacoplado, qué no, y cómo quitar el mock&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#555555"&gt;Desacoplar = que una pieza pueda cambiar sin obligar a cambiar las demás.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="70" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Lo que ya está desacoplado&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Frontend ↔ backend&lt;/b&gt;&lt;br&gt;Solo comparten el contrato (rutas, JSON, cookie, errores). El backend podría reescribirse en otro lenguaje y el frontend no se enteraría." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="410" height="150" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Services ↔ Axios&lt;/b&gt;&lt;br&gt;Los services llaman a &lt;i&gt;adapter.get()&lt;/i&gt;, no a Axios. Axios solo aparece en api.js y httpAdapter.js." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="470" y="145" width="410" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Real ↔ mock&lt;/b&gt;&lt;br&gt;Se cambia con una variable de entorno. Ninguna view, store ni service cambia." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="900" y="145" width="410" height="150" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Pantalla ↔ datos&lt;/b&gt;&lt;br&gt;Las views leen el store; no hacen peticiones. Si mañana los datos llegan por WebSocket, solo cambia el store." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1330" y="145" width="410" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Lo que todavía está acoplado (riesgos)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="900" height="30" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Mock y API se sincronizan a mano.&lt;/b&gt; Si el backend cambia un campo, el mock no avisa. Ejemplo real: en el mock el usuario client tiene &lt;font face="Courier New"&gt;organization_id: null&lt;/font&gt;, y en el backend un cliente sin organización recibe 403.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="410" height="190" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;El mock elige respuesta comparando strings de URL&lt;/b&gt; (&lt;font face="Courier New"&gt;if url === ...&lt;/font&gt;). Una ruta nueva sin su if devuelve un error en modo mock.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="470" y="370" width="410" height="190" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Stores y views conocen la forma de Axios&lt;/b&gt; (&lt;font face="Courier New"&gt;response.data.items&lt;/font&gt;). El mock tiene que imitarla. Si un día se cambia Axios por fetch, habría que mantener esa forma.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="900" y="370" width="410" height="190" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Se elige al compilar.&lt;/b&gt; VITE_* se fija en el build: para cambiar de mock a real hay que reiniciar o recompilar." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1330" y="370" width="410" height="190" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Cómo quitar el mock cuando ya no haga falta&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="900" height="30" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;1&lt;/b&gt; · Poner VITE_USE_MOCK=false (o quitarla) y comprobar con el backend real." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="400" height="90" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;2&lt;/b&gt; · adapter.js exporta solo httpAdapter." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="470" y="640" width="400" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;3&lt;/b&gt; · Borrar mockAdapter.js y services/fixtures/." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="900" y="640" width="400" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;4&lt;/b&gt; · Nada más: views, stores y services no cambian." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1330" y="640" width="400" height="90" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="Que quitar el mock sea borrar dos archivos y una línea es justo la prueba de que está bien desacoplado." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1690" height="70" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Cómo se podría desacoplar más (mejoras posibles, no hechas)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="900" height="30" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Generar el mock desde OpenAPI.&lt;/b&gt; La issue #148 (B13) pide OpenAPI completo con ejemplos para los mocks: los ejemplos del backend serían la fuente única y el mock no se desincronizaría." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="410" height="200" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Tests de contrato.&lt;/b&gt; Un test que compare las respuestas del mock con los schemas de Swagger y falle si no coinciden." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="470" y="910" width="410" height="200" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;Devolver solo los datos.&lt;/b&gt; Que el adapter devuelva &lt;font face="Courier New"&gt;response.data&lt;/font&gt; en vez del objeto de Axios: stores y mock dejarían de depender de la forma de Axios.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="900" y="910" width="410" height="200" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Inyectar el adapter.&lt;/b&gt; Pasarlo al crear cada service en vez de importarlo: así un test puede usar el mock y otro el real sin variables de entorno." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1330" y="910" width="410" height="200" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;En una frase:&lt;/b&gt; el frontend depende de un contrato y de una interfaz (adapter), no del backend ni de Axios. Por eso pudo trabajar con un mock y por eso cambiar al backend real es una variable de entorno." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="1690" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7 · CORS"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;font style="font-size:22px"&gt;&lt;b&gt;7 · CORS: quién puede llamar a la API desde un navegador&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#555555"&gt;Una regla de seguridad del navegador. Configurada por Ana en la #22: backend/app/main.py y backend/app/core/app_config.py.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="70" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;El problema: la política del mismo origen&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Origen&lt;/b&gt; = esquema + host + puerto&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;http://localhost:5173&lt;/font&gt; y &lt;font face="Courier New"&gt;http://localhost:8000&lt;/font&gt; son &lt;b&gt;orígenes distintos&lt;/b&gt; (cambia el puerto).&lt;br&gt;&lt;br&gt;Por seguridad, el navegador no deja que el JavaScript de una web lea respuestas de &lt;b&gt;otro origen&lt;/b&gt;, salvo que ese otro origen diga que sí.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="560" height="230" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;¿Por qué existe?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sin esta regla, una web maliciosa que visitas podría llamar a la API de AquaGuard con &lt;b&gt;tu&lt;/b&gt; cookie de sesión (el navegador la añade sola) y leer tus datos.&lt;br&gt;&lt;br&gt;CORS (Cross-Origin Resource Sharing) es la forma de que el servidor diga &lt;b&gt;qué orígenes sí&lt;/b&gt; pueden leer sus respuestas." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="640" y="145" width="560" height="230" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Importante&lt;/b&gt;&lt;br&gt;&lt;br&gt;CORS lo aplica &lt;b&gt;el navegador&lt;/b&gt;, no el servidor. El servidor solo envía cabeceras diciendo qué permite.&lt;br&gt;&lt;br&gt;Por eso al &lt;b&gt;simulador&lt;/b&gt; no le afecta: es un programa Python, no un navegador. Tampoco a curl ni a Postman." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1240" y="145" width="520" height="230" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Cómo lo ve el navegador: preflight + petición real&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Navegador (JS en :5173)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="340" height="56" as="geometry"/></mxCell><mxCell id="c8" value="" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="506" as="sourcePoint"/><mxPoint x="200" y="1010" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;Navegador (motor de CORS)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="730" y="450" width="340" height="56" as="geometry"/></mxCell><mxCell id="c10" value="" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="506" as="sourcePoint"/><mxPoint x="900" y="1010" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Backend :8000 · CORSMiddleware&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1430" y="450" width="340" height="56" as="geometry"/></mxCell><mxCell id="c12" value="" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1600" y="506" as="sourcePoint"/><mxPoint x="1600" y="1010" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="axios.patch('http://localhost:8000/api/alerts/7/resolve')" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="550" as="sourcePoint"/><mxPoint x="900" y="550" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="Otro origen y PATCH → antes pregunta permiso (&lt;b&gt;preflight&lt;/b&gt;)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="575" width="420" height="60" as="geometry"/></mxCell><mxCell id="c15" value="OPTIONS /api/alerts/7/resolve · Origin: http://localhost:5173 · Access-Control-Request-Method: PATCH" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="670" as="sourcePoint"/><mxPoint x="1600" y="670" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="¿Está el origen en CORS_ORIGINS?&lt;br&gt;Sí → responde con las cabeceras de permiso" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1390" y="695" width="420" height="70" as="geometry"/></mxCell><mxCell id="c17" value="200 · Access-Control-Allow-Origin: http://localhost:5173 · Allow-Credentials: true" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1600" y="800" as="sourcePoint"/><mxPoint x="900" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="PATCH /api/alerts/7/resolve + Cookie: aquaguard_session" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="860" as="sourcePoint"/><mxPoint x="1600" y="860" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="200 + JSON + Access-Control-Allow-Origin" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1600" y="920" as="sourcePoint"/><mxPoint x="900" y="920" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="el JS recibe la respuesta" style="html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="980" as="sourcePoint"/><mxPoint x="200" y="980" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Si el origen NO está permitido&lt;/b&gt;&lt;br&gt;El navegador bloquea la respuesta y el JavaScript recibe un error de red. En la consola: &lt;i&gt;«blocked by CORS policy: No 'Access-Control-Allow-Origin' header»&lt;/i&gt;. En nuestro frontend, normalizeError lo convierte en &lt;font face=&quot;Courier New&quot;&gt;NETWORK_ERROR&lt;/font&gt;." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="820" height="150" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Cuándo hay preflight&lt;/b&gt;&lt;br&gt;Para peticiones «no simples»: métodos como PATCH o DELETE, o cabeceras como Content-Type: application/json. Un GET sencillo va directo, pero la respuesta igualmente necesita Access-Control-Allow-Origin para que el JS pueda leerla." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="900" y="1040" width="860" height="150" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Cómo está configurado&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;core/app_config.py&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;CORS_ORIGINS: str =&lt;br&gt;&amp;nbsp;&amp;nbsp;"http://localhost:5173,http://localhost:3000"&lt;br&gt;&lt;br&gt;@property&lt;br&gt;def cors_origins_list(self):&lt;br&gt;&amp;nbsp;&amp;nbsp;return [o.strip() for o in&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.CORS_ORIGINS.split(",") if o.strip()]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;fontFamily=Courier New;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="560" height="170" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b&gt;main.py&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;app.add_middleware(&lt;br&gt;&amp;nbsp;&amp;nbsp;CORSMiddleware,&lt;br&gt;&amp;nbsp;&amp;nbsp;allow_origins=app_settings.cors_origins_list,&lt;br&gt;&amp;nbsp;&amp;nbsp;allow_credentials=True,&lt;br&gt;&amp;nbsp;&amp;nbsp;allow_methods=["*"],&lt;br&gt;&amp;nbsp;&amp;nbsp;allow_headers=["*"],&lt;br&gt;)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;fontFamily=Courier New;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="1260" width="560" height="170" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;Las decisiones&lt;/b&gt;&lt;br&gt;· Lista en una variable de entorno (.env.example): cada despliegue pone sus orígenes sin tocar código.&lt;br&gt;· &lt;b&gt;allow_credentials=True&lt;/b&gt;: sin él, el navegador no envía la cookie.&lt;br&gt;· Con credenciales el estándar &lt;b&gt;prohíbe "*"&lt;/b&gt; como origen: hay que listarlos.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="1260" width="560" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="8 · CORS en AquaGuard"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;font style="font-size:22px"&gt;&lt;b&gt;8 · ¿Cuándo actúa de verdad el CORS en AquaGuard?&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#555555"&gt;Casi nunca, y es a propósito: nginx en producción y Vite en desarrollo hacen que el navegador vea un solo origen.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="70" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="400" height="64" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;¿Origen del frontend?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;rounded=0;" vertex="1" parent="1"><mxGeometry x="440" y="120" width="260" height="64" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;¿Adónde llama?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;rounded=0;" vertex="1" parent="1"><mxGeometry x="700" y="120" width="380" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;¿Mismo origen?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;rounded=0;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="200" height="64" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;¿Actúa CORS?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;rounded=0;" vertex="1" parent="1"><mxGeometry x="1280" y="120" width="480" height="64" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Producción&lt;/b&gt; (nginx)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="400" height="64" as="geometry"/></mxCell><mxCell id="c8" value="https://localhost" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="440" y="190" width="260" height="64" as="geometry"/></mxCell><mxCell id="c9" value="/api → nginx → backend:8000" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="700" y="190" width="380" height="64" as="geometry"/></mxCell><mxCell id="c10" value="Sí" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="1080" y="190" width="200" height="64" as="geometry"/></mxCell><mxCell id="c11" value="No" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="1280" y="190" width="480" height="64" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Desarrollo&lt;/b&gt; (Vite)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="400" height="64" as="geometry"/></mxCell><mxCell id="c13" value="http://localhost:5173" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="440" y="260" width="260" height="64" as="geometry"/></mxCell><mxCell id="c14" value="/api → proxy de Vite → :8000" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="700" y="260" width="380" height="64" as="geometry"/></mxCell><mxCell id="c15" value="Sí" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="1080" y="260" width="200" height="64" as="geometry"/></mxCell><mxCell id="c16" value="No" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="1280" y="260" width="480" height="64" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Desarrollo&lt;/b&gt; con VITE_API_URL=http://localhost:8000" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="400" height="64" as="geometry"/></mxCell><mxCell id="c18" value="http://localhost:5173" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="440" y="330" width="260" height="64" as="geometry"/></mxCell><mxCell id="c19" value="directo a :8000" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="700" y="330" width="380" height="64" as="geometry"/></mxCell><mxCell id="c20" value="No" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="1080" y="330" width="200" height="64" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Sí&lt;/b&gt;: :5173 está en la lista" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;rounded=0;" vertex="1" parent="1"><mxGeometry x="1280" y="330" width="480" height="64" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Simulador&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="400" height="64" as="geometry"/></mxCell><mxCell id="c23" value="(no es un navegador)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="440" y="400" width="260" height="64" as="geometry"/></mxCell><mxCell id="c24" value="backend:8000" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="700" y="400" width="380" height="64" as="geometry"/></mxCell><mxCell id="c25" value="—" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="1080" y="400" width="200" height="64" as="geometry"/></mxCell><mxCell id="c26" value="No: CORS solo lo aplica el navegador" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="1280" y="400" width="480" height="64" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Swagger&lt;/b&gt; /api/docs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="400" height="64" as="geometry"/></mxCell><mxCell id="c28" value="el propio backend" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="440" y="470" width="260" height="64" as="geometry"/></mxCell><mxCell id="c29" value="/api del mismo backend" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="700" y="470" width="380" height="64" as="geometry"/></mxCell><mxCell id="c30" value="Sí" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="1080" y="470" width="200" height="64" as="geometry"/></mxCell><mxCell id="c31" value="No" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="1280" y="470" width="480" height="64" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Entonces, ¿para qué está?&lt;/b&gt;&lt;br&gt;&lt;br&gt;· Para que funcione si alguien sirve el frontend en otro origen y llama directo al backend (VITE_API_URL apuntando a :8000, o el puerto 3000).&lt;br&gt;&lt;br&gt;· Como defensa: si un día se separan frontend y backend en dominios distintos, solo hay que añadir el nuevo origen a CORS_ORIGINS." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="840" height="260" as="geometry"/></mxCell><mxCell id="c33" value='&lt;b&gt;Un detalle para no confundirse&lt;/b&gt;&lt;br&gt;&lt;br&gt;https://localhost (el origen de producción) &lt;b&gt;no está&lt;/b&gt; en CORS_ORIGINS, y no hace falta: el navegador llama a /api del mismo origen y nginx lo reenvía por dentro. CORS solo mira llamadas entre orígenes distintos.&lt;br&gt;&lt;br&gt;Si te preguntan «¿por qué no ponéis "*"?»: porque con cookies (allow_credentials) el estándar no lo permite, y además abriría la API a cualquier web.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="920" y="570" width="840" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>